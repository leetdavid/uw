# uw's agent: chats and the tools they use. See docs/plans/agent-chats.md.

source_set("agent") {
  sources = [
    "agent_loop.cc",
    "agent_loop.h",
    "agent_terminal_tools.cc",
    "agent_tools.cc",
    "agent_tools.h",
    "chat_suggestions.cc",
    "chat_suggestions.h",
  ]
  public_deps = [
    ":chats",
    "//base",
    "//components/actor/core:task_id",
    "//components/history/core/browser",
    "//components/tabs:public",
    "//url",
    "//uw/browser/ai_providers",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/components/agent",
    "//uw/components/terminal",
  ]
  deps = [
    "//chrome/browser/actor",
    "//chrome/browser/history",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/common",
    "//chrome/common:actor_webui_mojom",
    "//components/actor/core",
    "//components/keyed_service/core",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//ui/base",
    "//uw/browser/terminal",
  ]
}

# The saved chats and the list of them, which the sidebar reads too.
source_set("chats") {
  sources = [
    "chat_file.cc",
    "chat_file.h",
    "chat_index.cc",
    "chat_index.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//chrome/browser/profiles:profile" ]
}

# What the browser's commands need to open a chat.
source_set("chat_tab") {
  sources = [
    "chat_tab.cc",
    "chat_tab.h",
  ]
  public_deps = [
    "//components/tabs:public",
    "//url",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/browser_window",
    "//content/public/browser",
    "//content/public/common",
    "//ui/base",
  ]
}

# The notification a chat sends when it finishes or waits for approval, and
# what a click on it does. Chromium's notification service registers the
# handler, so nothing here may depend on that service's implementation.
source_set("chat_notification") {
  sources = [
    "chat_notification.cc",
    "chat_notification.h",
  ]
  public_deps = [ "//chrome/browser/notifications" ]
  deps = [
    ":chat_tab",
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/tabs:public",
    "//ui/base",
    "//ui/gfx",
    "//ui/message_center/public/cpp",
    "//url",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "scripted_model.cc",
    "scripted_model.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//net:test_support" ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "agent_engine_browsertest.cc",
    "agent_loop_browsertest.cc",
    "agent_tools_browsertest.cc",
  ]
  deps = [
    ":agent",
    ":test_support",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/actor",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/actor/core",
    "//components/prefs",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/tabs:public",
    "//content/public/browser",
    "//content/test:test_support",
    "//net",
    "//net:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/geometry",
    "//url",
    "//uw/browser/tab_organization",
    "//uw/browser/terminal",
    "//uw/components/ai_providers",
    "//uw/components/terminal",
  ]
}
