# uw's agent: chats and the tools they use. See docs/plans/agent-chats.md.

source_set("agent") {
  sources = [
    "agent_loop.cc",
    "agent_loop.h",
    "agent_tools.cc",
    "agent_tools.h",
    "chat_file.cc",
    "chat_file.h",
    "chat_index.cc",
    "chat_index.h",
  ]
  public_deps = [
    "//base",
    "//components/actor/core:task_id",
    "//components/tabs:public",
    "//url",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/components/agent",
  ]
  deps = [
    "//chrome/browser/actor",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/common",
    "//components/actor/core",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//ui/base",
  ]
}

# What the browser's commands need to open a chat.
source_set("chat_tab") {
  sources = [
    "chat_tab.cc",
    "chat_tab.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//content/public/common",
    "//url",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "scripted_model.cc",
    "scripted_model.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//net:test_support" ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "agent_engine_browsertest.cc",
    "agent_loop_browsertest.cc",
    "agent_tools_browsertest.cc",
  ]
  deps = [
    ":agent",
    ":test_support",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/actor",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/actor/core",
    "//components/tabs:public",
    "//content/public/browser",
    "//content/test:test_support",
    "//net",
    "//net:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/geometry",
    "//url",
    "//uw/browser/tab_organization",
  ]
}
