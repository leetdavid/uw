# uw's agent: chats and the tools they use. See docs/plans/agent-chats.md.

source_set("agent") {
  sources = [
    "agent_loop.cc",
    "agent_loop.h",
    "agent_terminal_tools.cc",
    "agent_tools.cc",
    "agent_tools.h",
    "chat_files.cc",
    "chat_files.h",
    "chat_suggestions.cc",
    "chat_suggestions.h",
    "quick_check.cc",
    "quick_check.h",
  ]
  public_deps = [
    ":chats",
    ":memory_store",
    "//base",
    "//components/actor/core:task_id",
    "//components/history/core/browser",
    "//components/tabs:public",
    "//url",
    "//uw/browser/ai_providers",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/components/agent",
    "//uw/components/connectors",
    "//uw/components/terminal",
  ]
  deps = [
    "//chrome/browser/actor",
    "//chrome/browser/history",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/common",
    "//chrome/common:actor_webui_mojom",
    "//components/actor/core",
    "//components/keyed_service/core",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//components/prefs",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//ui/base",
    "//uw/browser/connectors",
    "//uw/browser/terminal",
  ]
}

# A profile's agent memory, which chats, uw://ai/memory, and the uw command
# read. See docs/plans/agent-memory.md.
source_set("memory_store") {
  sources = [
    "memory_store.cc",
    "memory_store.h",
  ]
  public_deps = [
    "//base",
    "//uw/components/agent",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//sql",
  ]
}

# Where skills live, which chats and uw://ai/skills both read.
source_set("skill_folders") {
  sources = [
    "skill_folders.cc",
    "skill_folders.h",
  ]
  public_deps = [
    "//base",
    "//uw/components/agent",
  ]
  deps = [ "//chrome/common:constants" ]
}

# The saved chats and the list of them, which the sidebar reads too.
source_set("chats") {
  sources = [
    "chat_alerts.cc",
    "chat_alerts.h",
    "chat_file.cc",
    "chat_file.h",
    "chat_index.cc",
    "chat_index.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//chrome/browser/profiles:profile" ]
}

# Whether a browser window is the run window. Chromium's own files ask, so
# this depends on nothing but //base.
source_set("run_window_mark") {
  sources = [
    "run_window_mark.cc",
    "run_window_mark.h",
  ]
  deps = [ "//base" ]
}

# The window scheduled runs open their tabs in, never shown.
source_set("run_window") {
  sources = [
    "run_window.cc",
    "run_window.h",
  ]
  deps = [
    ":run_window_mark",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//url",
  ]
}

# One run of a scheduled chat, a subagent in the run window.
source_set("chat_run") {
  sources = [
    "chat_run.cc",
    "chat_run.h",
  ]
  public_deps = [
    ":agent",
    "//base",
    "//components/tabs:public",
    "//uw/components/agent",
  ]
  deps = [ ":run_window" ]
}

# A profile's scheduled chats: their schedules, and the runs that fire.
source_set("scheduled_chats") {
  sources = [
    "chat_triggers.cc",
    "chat_triggers.h",
    "scheduled_chats.cc",
    "scheduled_chats.h",
    "trigger_process.cc",
    "trigger_process.h",
  ]
  public_deps = [
    ":agent",
    ":chat_run",
    ":chats",
    "//base",
    "//mojo/public/cpp/bindings",
    "//services/device/public/mojom",
    "//uw/components/agent",
    "//uw/components/ai_providers",
  ]
  deps = [
    ":chat_notification",
    ":run_window",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles/keep_alive",
    "//content/public/browser",
    "//uw/browser/ai_providers",
    "//uw/browser/connectors",
    "//uw/components/terminal",
  ]
}

# What the browser's commands need to open a chat.
source_set("chat_tab") {
  sources = [
    "chat_tab.cc",
    "chat_tab.h",
  ]
  public_deps = [
    "//components/tabs:public",
    "//url",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/browser_window",
    "//content/public/browser",
    "//content/public/common",
    "//ui/base",
  ]
}

# The notification a chat sends when it finishes or waits for approval, and
# what a click on it does. Chromium's notification service registers the
# handler, so nothing here may depend on that service's implementation.
source_set("chat_notification") {
  sources = [
    "chat_notification.cc",
    "chat_notification.h",
  ]
  public_deps = [ "//chrome/browser/notifications" ]
  deps = [
    ":chat_tab",
    ":chats",
    "//base",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/navigator",
    "//components/tabs:public",
    "//ui/base",
    "//ui/gfx",
    "//ui/message_center/public/cpp",
    "//url",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "scripted_model.cc",
    "scripted_model.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//net:test_support" ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "agent_engine_browsertest.cc",
    "agent_loop_browsertest.cc",
    "agent_tools_browsertest.cc",
    "chat_run_browsertest.cc",
    "memory_store_browsertest.cc",
    "quick_check_browsertest.cc",
    "run_window_browsertest.cc",
    "scheduled_chats_browsertest.cc",
  ]
  deps = [
    ":agent",
    ":chat_run",
    ":chat_tab",
    ":chats",
    ":scheduled_chats",
    ":run_window",
    ":run_window_mark",
    ":test_support",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/actor",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles:profile_test_util",
    "//chrome/browser/profiles/keep_alive",
    "//chrome/browser/sessions",
    "//chrome/browser/ui",
    "//chrome/browser/ui/browser_window",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/actor/core",
    "//components/keep_alive_registry",
    "//components/prefs",
    "//components/safe_browsing/core/common:safe_browsing_prefs",
    "//components/sessions",
    "//components/tabs:public",
    "//content/public/browser",
    "//content/test:test_support",
    "//net",
    "//net:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//ui/message_center/public/cpp",
    "//ui/gfx/geometry",
    "//url",
    "//uw/browser/ai_providers",
    "//uw/browser/ai_providers:test_support",
    "//uw/browser/tab_organization",
    "//uw/browser/terminal",
    "//uw/components/ai_providers",
    "//uw/components/terminal",
  ]
}
