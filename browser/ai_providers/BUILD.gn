# The AI providers as the browser reaches them: the models picked on
# uw://ai/providers, their keys in the Keychain, and requests to them. Chats and
# the organizer both use it. See docs/plans/ai-providers.md.
source_set("ai_providers") {
  sources = [
    "api_key_store.h",
    "catalog_store.cc",
    "catalog_store.h",
    "decision_probes.cc",
    "decision_probes.h",
    "model_lister.cc",
    "model_lister.h",
    "models.cc",
    "models.h",
    "provider_sync.cc",
    "provider_sync.h",
    "rejected_keys.cc",
    "rejected_keys.h",
    "remote_model_client.cc",
    "remote_model_client.h",
  ]
  if (is_mac) {
    # macOS Keychain storage.
    sources += [ "api_key_store_mac.mm" ]
  } else if (is_win) {
    # Files encrypted with DPAPI for the Windows user.
    sources += [ "api_key_store_win.cc" ]
    libs = [ "crypt32.lib" ]
  } else {
    # In-memory fallback so other builds link. Secrets never leave the
    # process and never touch disk.
    sources += [ "api_key_store_stub.cc" ]
  }
  public_deps = [
    "//base",
    "//url",
    "//uw/components/ai_providers",
    "//uw/components/tab_organization",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//components/os_crypt/common:switches",
    "//components/prefs",
    "//content/public/browser",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//uw/components/agent",
  ]
  if (is_win) {
    deps += [ "//chrome/common:constants" ]
  }
}

source_set("test_support") {
  testonly = true
  sources = [
    "model_test_server.cc",
    "model_test_server.h",
    "scoped_memory_keychain.h",
  ]
  if (is_mac) {
    sources += [ "scoped_memory_keychain.mm" ]
  } else {
    sources += [ "scoped_memory_keychain_stub.cc" ]
  }
  deps = [
    "//base",
    "//crypto",
    "//net:test_support",
    "//testing/gtest",
    "//url",
  ]
}
