import("//build/buildflag_header.gni")
import("identity.gni")

# Whether this build is uw dev. See docs/adr/0028-local-builds-are-uw-dev.md.
buildflag_header("identity_buildflags") {
  header = "identity_buildflags.h"
  flags = [ "UW_DEV=$uw_dev" ]
}

declare_args() {
  # A Windows release's version, report addresses, and update feed, which a
  # Mac release keeps in Info.plist instead. Development builds leave them
  # empty, so they send nothing and look for no updates. See
  # docs/plans/windows.md.
  uw_release_version = ""
  uw_crash_report_url = ""
  uw_posthog_key = ""
  uw_posthog_host = ""
  uw_update_feed_url = ""
}

buildflag_header("release_buildflags") {
  header = "release_buildflags.h"
  flags = [
    "UW_RELEASE_VERSION=\"$uw_release_version\"",
    "UW_CRASH_REPORT_URL=\"$uw_crash_report_url\"",
    "UW_POSTHOG_KEY=\"$uw_posthog_key\"",
    "UW_POSTHOG_HOST=\"$uw_posthog_host\"",
    "UW_UPDATE_FEED_URL=\"$uw_update_feed_url\"",
  ]
}

# uw's own version in a release build. See docs/plans/distribution.md.

source_set("release_version") {
  sources = [ "release_version.h" ]
  deps = [
    "//base",
    "//base/version_info",
  ]
  if (is_mac) {
    sources += [ "release_version_mac.mm" ]
    frameworks = [ "Foundation.framework" ]
  } else if (is_win) {
    sources += [ "release_version_win.cc" ]
    deps += [ ":release_buildflags" ]
  } else {
    sources += [ "release_version_stub.cc" ]
  }
}

source_set("report_issue") {
  sources = [
    "report_issue.cc",
    "report_issue.h",
  ]
  deps = [
    ":release_version",
    "//base",
    "//base/version_info",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "release_version_browsertest.mm" ]
  if (uw_dev) {
    sources += [ "uw_dev_browsertest.mm" ]
  }
  deps = [
    ":release_version",
    ":report_issue",
    "//base",
    "//base/test:test_support",
    "//base/version_info",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/ui",
    "//chrome/browser/ui/webui/version",
    "//chrome/test:test_support",
    "//components/os_crypt/common:switches",
    "//content/public/browser",
    "//content/test:test_support",
    "//net",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
    "//uw/browser/ai_providers",
    "//uw/browser/ai_providers:test_support",
    "//uw/browser/tab_organization",
    "//uw/browser/uw_command",
    "//uw/components/ai_providers",
  ]
  frameworks = [ "Foundation.framework" ]
}
