# The uw://chat page, one chat with uw's agent, uw://ai, the AI page, and
# the watch card under the eye in the address bar, and every uw page's
# problems.js, which reports what goes wrong on the page. All three are one React
# app in app/, built from Fluid Functionalism's parts. app/bundle.ts checks
# its types, bundles it with Chromium's node, and puts the pages' files in
# one folder; the bundle carries the pages' mojo bindings.
import("//third_party/node/node.gni")
import("//tools/grit/grit_rule.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

assert(!is_android)

app_dir = "$target_gen_dir/app"
app_files = [
  "chat.html",
  "providers.html",
  "watch_card.html",
  "favicon.svg",
  "plug.svg",
  "chat.js",
  "providers.js",
  "watch_card.js",
  "problems.js",
  "chat.css",
  "icons/openai.svg",
  "icons/anthropic.svg",
  "icons/openrouter.svg",
  "icons/vercel.svg",
  "icons/ollama.svg",
  "icons/exa.svg",
  "inter-latin.woff2",
  "inter-latin-ext.woff2",
  "pdf.js",
  "pdf.worker.js",
]

node("app") {
  script = "//third_party/node/node.py"
  inputs = [
    "app/bundle.ts",
    "chat.html",
    "providers.html",
    "watch_card.html",
    "favicon.svg",
    "plug.svg",
  ]
  outputs = []
  foreach(file, app_files) {
    outputs += [ "$app_dir/$file" ]
  }
  depfile = "$target_gen_dir/app.d"
  deps = [
    "//ui/webui/resources/cr_components/color_change_listener:build_ts",
    "//ui/webui/resources/mojo:build_ts",
    "//uw/browser/ui/webui/uw_chat:mojo_bindings_ts__generator",
    "//uw/browser/ui/webui/uw_providers:mojo_bindings_ts__generator",
    "//uw/browser/problem_reports:mojo_bindings_ts__generator",
  ]
  args = [
    rebase_path("app/bundle.ts", root_build_dir),
    "--out",
    rebase_path(app_dir, root_build_dir),
    "--gen",
    rebase_path(root_gen_dir, root_build_dir),
    "--depfile",
    rebase_path(depfile, root_build_dir),
  ]
}

generate_grd("build_grd") {
  grd_prefix = "uw_chat"
  out_grd = "$target_gen_dir/resources.grd"
  input_files = app_files
  input_files_base_dir = rebase_path(app_dir, root_build_dir)
  deps = [ ":app" ]
}

grit("resources") {
  # The grd is generated at build time.
  enable_input_discovery_for_gn_analyze = false
  source = "$target_gen_dir/resources.grd"
  deps = [ ":build_grd" ]
  outputs = [
    "grit/uw_chat_resources.h",
    "grit/uw_chat_resources_map.cc",
    "grit/uw_chat_resources_map.h",
    "uw_chat_resources.pak",
  ]
  output_dir = "$root_gen_dir/chrome"
}
