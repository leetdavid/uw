# The uw://chat page: one chat with uw's agent.
import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "uw_chat"

  static_files = [
    "chat.html",
    "favicon.svg",
  ]
  ts_files = [ "chat.ts" ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps = [ "//uw/browser/ui/webui/uw_chat:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/uw/browser/ui/webui/uw_chat/uw_chat.mojom-webui.ts" ]

  webui_context_type = "trusted"
}
