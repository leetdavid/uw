# The command bar's page: a field and the suggestions for what is typed.
import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "uw_command_bar"

  static_files = [ "command_bar.html" ]
  ts_files = [ "command_bar.ts" ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"
}
