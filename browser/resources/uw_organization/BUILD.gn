# WebUI resources for the uw organization section of chrome://settings.
# Built as its own target and mapped into the settings build via
# ts_path_mappings, mirroring how settings_shared is consumed.
import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "uw_organization"

  # Served under chrome://settings/uw/uw_organization/ (see
  # ts_path_mappings in the settings build and AddResourcePaths in
  # settings_ui.cc).
  grd_resource_path_prefix = "uw/uw_organization"

  ts_files = [
    "uw_organization_browser_proxy.ts",
    "uw_organization_page.html.ts",
    "uw_organization_page.ts",
  ]

  ts_composite = true
  ts_definitions = [
    "//tools/typescript/definitions/chrome_event.d.ts",
    "//tools/typescript/definitions/chrome_send.d.ts",
  ]
  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps =
      [ "//uw/browser/ui/webui/uw_organization:mojo_bindings_ts__generator" ]
  mojo_files = [
    "$root_gen_dir/uw/browser/ui/webui/uw_organization/uw_organization.mojom-webui.ts",
  ]

  webui_context_type = "trusted"
}
