# The theme picker's page: the mode, a color field of up to three dots, the
# suggested themes, intensity, grain, and theme colors in dark mode.
import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "uw_theme_picker"

  static_files = [ "theme_picker.html" ]
  ts_files = [ "theme_picker.ts" ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  mojo_files_deps =
      [ "//uw/browser/ui/webui/uw_theme_picker:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/uw/browser/ui/webui/uw_theme_picker/uw_theme_picker.mojom-webui.ts" ]

  webui_context_type = "trusted"
}
