source_set("tab_organization") {
  sources = [
    "tab_organization_controller.cc",
    "tab_organization_controller.h",
  ]
  public_deps = [
    "//base",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/tab_groups",
    "//components/tabs:public",
    "//ui/base/unowned_user_data",
    "//uw/components/tab_organization",
  ]
  deps = [
    "//chrome:strings",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/sessions",
    "//chrome/browser/ui/browser_window",
    "//chrome/common:constants",
    "//components/prefs",
    "//components/sessions",
    "//content/public/browser",
    "//ui/base",
    "//ui/menus",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "tab_organization_controller_browsertest.cc" ]
  deps = [
    ":tab_organization",
    "//base",
    "//chrome/browser",
    "//chrome/browser/ui",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/prefs",
    "//components/tab_groups",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}

source_set("ai_connection") {
  sources = [
    "ai_connection.cc",
    "ai_connection.h",
    "api_key_store.h",
    "remote_model_client.cc",
    "remote_model_client.h",
  ]
  if (is_mac) {
    # macOS Keychain storage. The first release targets macOS desktop.
    sources += [ "api_key_store_mac.mm" ]
  } else {
    # In-memory fallback so non-macOS builds link. Secrets never leave the
    # process and never touch disk.
    sources += [ "api_key_store_stub.cc" ]
  }
  public_deps = [ "//base" ]
  deps = [
    "//components/pref_registry",
    "//components/prefs",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}
