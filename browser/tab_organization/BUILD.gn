    "tab_organization_controller_browsertest.cc",
    "window_screenshot_browsertest.cc",
  ]
  deps = [
    ":ai_connection",
    ":tab_organization",
    ":test_support",
    "//components/content_extraction/content/browser",
    "//net:test_support",
    "//uw/browser/ui/views/tab_organization",
    "//base",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/ui",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/prefs",
    "//components/tab_groups",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/views:test_support",
    "//url",
  ]
}

source_set("test_support") {
  testonly = true
  sources = [
    "model_test_server.cc",
    "model_test_server.h",
    "scoped_memory_keychain.h",
    "scoped_memory_keychain.mm",
    "window_screenshot.cc",
    "window_screenshot.h",
  ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome/browser/ui",
    "//components/viz/common",
    "//crypto",
    "//net:test_support",
    "//skia",
    "//testing/gtest",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/views",
    "//url",
  ]
}

source_set("ai_connection") {
  sources = [
    "ai_connection.cc",
    "ai_connection.h",
    "api_key_store.h",
    "remote_model_client.cc",
    "remote_model_client.h",
  ]
  if (is_mac) {
    # macOS Keychain storage. The first release targets macOS desktop.
    sources += [ "api_key_store_mac.mm" ]
  } else {
    # In-memory fallback so non-macOS builds link. Secrets never leave the
    # process and never touch disk.
    sources += [ "api_key_store_stub.cc" ]
  }
  public_deps = [
    "//base",
    "//uw/components/tab_organization",
  ]
  deps = [
    "//components/pref_registry",
    "//components/prefs",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}
