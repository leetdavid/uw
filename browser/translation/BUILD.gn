# Page translation with the translation engine the user picks. See
# docs/plans/page-translation.md.
source_set("prefs") {
  sources = [
    "translation_prefs.cc",
    "translation_prefs.h",
  ]
  deps = [ "//components/pref_registry" ]
}

source_set("translation") {
  sources = [
    "ai_translator.cc",
    "ai_translator.h",
    "device_translator.cc",
    "device_translator.h",
    "google_cloud_translator.cc",
    "google_cloud_translator.h",
    "page_translator.cc",
    "page_translator.h",
    "segment_translator.cc",
    "segment_translator.h",
    "translation_engine.cc",
    "translation_engine.h",
  ]
  public_deps = [
    ":prefs",
    "//base",
    "//components/on_device_translation",
    "//components/on_device_translation/public/mojom",
    "//components/translate/content/browser",
    "//mojo/public/cpp/bindings",
  ]
  deps = [
    "//chrome/browser:browser_process",
    "//chrome/browser/on_device_translation",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/translate",
    "//components/prefs",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//ui/base",
    "//url",
    "//uw/browser/ai_providers",
    "//uw/components/agent",
    "//uw/components/ai_providers",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "page_translation_browsertest.cc",
    "translation_engines_browsertest.cc",
  ]
  deps = [
    ":menu",
    ":translation",
    "//chrome/browser:browser_process",
    "//components/prefs",
    "//uw/browser/ai_providers",
    "//uw/browser/ai_providers:test_support",
    "//uw/components/ai_providers",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/translate",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//components/on_device_translation:features",
    "//components/on_device_translation/service:test_support",
    "//components/translate/core/browser",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
  ]
}

# The translation items of a page's right-click menu and the app menu.
source_set("menu") {
  sources = [
    "translate_menu.cc",
    "translate_menu.h",
  ]
  public_deps = [ "//ui/menus" ]
  deps = [
    ":translation",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/translate",
    "//components/translate/core/browser",
    "//content/public/browser",
  ]
}

source_set("ui_browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "translation_ui_browsertest.cc" ]
  deps = [
    ":menu",
    ":translation",
    "//base",
    "//base/test:test_support",
    "//chrome/app:command_ids",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/renderer_context_menu:test_support",
    "//chrome/browser/translate",
    "//chrome/browser/ui",
    "//chrome/browser/ui/views/translate",
    "//chrome/test:test_support",
    "//components/translate/core/browser",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/views",
  ]
}
