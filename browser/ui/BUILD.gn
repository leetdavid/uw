# uw browser interface helpers shared across windows.
source_set("ui") {
  sources = [
    "uw_url_rewrite.cc",
    "uw_url_rewrite.h",
  ]
  public_deps = [
    "//content/public/browser",
    "//url",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "uw_url_rewrite_browsertest.cc" ]
  deps = [
    ":ui",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//content/public/common",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
    "//url",
  ]
}
