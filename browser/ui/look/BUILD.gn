# The Arc-style look: tint colors, the window gradient, and favorite tiles.
source_set("look") {
  sources = [
    "favorite_tile.cc",
    "favorite_tile.h",
    "page_card.h",
    "tint_color_mixer.cc",
    "tint_color_mixer.h",
    "tint_painter.cc",
    "tint_painter.h",
  ]
  public_deps = [ "//uw/components/look" ]
  deps = [
    "//cc/paint",
    "//chrome/browser/ui/color:color_headers",
    "//skia",
    "//ui/color",
    "//ui/gfx",
    "//ui/gfx:color_utils",
    "//ui/views",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "tint_browsertest.cc" ]
  deps = [
    ":look",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/themes",
    "//chrome/browser/ui",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//components/prefs",
    "//content/test:test_support",
    "//skia",
    "//testing/gtest",
    "//ui/base/mojom",
    "//ui/color",
    "//uw/browser/tab_organization:test_support",
  ]
}
