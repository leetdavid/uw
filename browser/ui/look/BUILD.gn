# The Arc-style look: tint colors, the window gradient, the inactive window
# buttons, and the fills of sidebar tabs.
source_set("look") {
  sources = [
    "page_card.h",
    "sidebar_tab_fill.cc",
    "sidebar_tab_fill.h",
    "tint_color_mixer.cc",
    "tint_color_mixer.h",
    "tint_painter.cc",
    "tint_painter.h",
  ]
  if (is_mac) {
    sources += [
      "window_buttons.h",
      "window_buttons_mac.mm",
    ]
  }
  public_deps = [ "//uw/components/look" ]
  deps = [
    "//base",
    "//cc/paint",
    "//chrome/browser/ui/color:color_headers",
    "//components/prefs",
    "//skia",
    "//ui/color",
    "//ui/gfx",
    "//ui/gfx:color_utils",
    "//ui/views",
    "//uw/components/look:prefs",
  ]
  if (is_mac) {
    frameworks = [ "AppKit.framework" ]
  }
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "tint_browsertest.cc" ]
  if (is_mac) {
    sources += [ "window_buttons_browsertest.mm" ]
  }
  deps = [
    ":look",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/profiles:profile_test_util",
    "//chrome/browser/themes",
    "//chrome/browser/ui",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/common:constants",
    "//chrome/test:test_support",
    "//components/prefs",
    "//content/test:test_support",
    "//skia",
    "//testing/gtest",
    "//ui/base/mojom",
    "//ui/color",
    "//ui/gfx:color_utils",
    "//ui/views",
    "//url",
    "//uw/browser/tab_organization:test_support",
    "//uw/components/look:prefs",
  ]
}
