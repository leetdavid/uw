# uw's own line icons, drawn as in the designs, for what Chromium has no
# icon for.
import("//components/vector_icons/vector_icons.gni")

aggregate_vector_icons("uw_vector_icons") {
  icon_directory = "."

  sources = [
    "arrow_down.icon",
    "chevrons_up_down.icon",
    "eye_filled.icon",
    "inbox.icon",
    "life_buoy.icon",
    "list_tree.icon",
    "log_in.icon",
    "mini_player_back_to_tab.icon",
    "mini_player_close.icon",
    "mini_player_dock.icon",
    "mini_player_fast_forward.icon",
    "mini_player_forward.icon",
    "mini_player_muted.icon",
    "mini_player_pause.icon",
    "mini_player_pop_out.icon",
    "mini_player_play.icon",
    "mini_player_replay.icon",
    "mini_player_volume.icon",
    "palette.icon",
    "smile.icon",
    "sparkles.icon",
    "user.icon",
  ]
}

source_set("vector_icons") {
  sources = get_target_outputs(":uw_vector_icons")

  deps = [
    ":uw_vector_icons",
    "//base",
    "//skia",
    "//ui/gfx",
  ]
}
