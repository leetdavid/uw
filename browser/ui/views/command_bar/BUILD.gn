# The command bar's panel over the page card.
source_set("command_bar") {
  sources = [
    "command_bar.cc",
    "command_bar.h",
  ]
  public_deps = [
    "//base",
    "//components/prefs",
    "//ui/base/unowned_user_data",
  ]
  deps = [
    "//chrome:strings",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/views/bubble",
    "//chrome/browser/ui/webui/top_chrome",
    "//components/input",
    "//content/public/browser",
    "//ui/gfx",
    "//ui/views",
    "//url",
    "//uw/browser/agent:chat_tab",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/terminal",
    "//uw/browser/ui/webui/uw_command_bar",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "command_bar_browsertest.mm" ]
  deps = [
    ":command_bar",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/search_engines",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//components/prefs",
    "//components/search_engines",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gtest",
    "//ui/base/clipboard",
    "//ui/events:test_support",
    "//ui/gfx:gfx_switches",
    "//ui/views",
    "//uw/browser/agent:chat_tab",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/tab_organization:test_support",
    "//uw/browser/terminal",
    "//uw/browser/ui/webui/uw_command_bar",
  ]
}
