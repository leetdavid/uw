# The question a close asks while a terminal tab runs a program. See
# docs/plans/terminal-tab.md#busy-terminal-warning.
source_set("terminal") {
  sources = [
    "close_warning.cc",
    "close_warning.h",
  ]
  public_deps = [
    "//base",
    "//components/tab_groups",
    "//uw/browser/terminal",
    "//uw/browser/terminal:close_guard",
  ]
  deps = [
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/lifetime",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/constrained_window",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//ui/color",
    "//ui/gfx",
    "//ui/views",
    "//uw/browser/agent:chat_tab",
    "//uw/browser/ui/vector_icons",
    "//uw/browser/ui/views/tab_organization",
    "//uw/browser/workspaces",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "close_warning_browsertest.cc" ]
  deps = [
    ":terminal",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/lifetime",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//components/tab_groups",
    "//components/tabs:public",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/base",
    "//ui/views",
    "//url",
    "//uw/browser/agent:chat_tab",
    "//uw/browser/agent:test_support",
    "//uw/browser/tab_organization",
    "//uw/browser/tab_organization:test_support",
  ]
}
