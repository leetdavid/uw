# The uw://chat page's browser side: its controller and the handler that runs
# the agent.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "uw_chat.mojom" ]
  webui_module_path = "/"
}

source_set("uw_chat") {
  sources = [
    "schedule_card.cc",
    "schedule_card.h",
    "uw_chat_handler.cc",
    "uw_chat_handler.h",
    "uw_chat_ui.cc",
    "uw_chat_ui.h",
    "uw_watch_card_handler.cc",
    "uw_watch_card_handler.h",
    "uw_watch_card_ui.cc",
    "uw_watch_card_ui.h",
  ]
  public_deps = [
    ":mojo_bindings",
    "//base",
    "//chrome/browser/ui/webui/top_chrome",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
    "//uw/browser/agent",
    "//uw/browser/agent:chat_tab",
    "//uw/browser/ui/webui/uw_providers",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/common:constants",
    "//components/favicon/content",
    "//components/performance_manager",
    "//components/prefs",
    "//components/split_tabs",
    "//components/tabs:public",
    "//components/url_formatter",
    "//components/viz/common",
    "//content/public/common",
    "//net",
    "//ui/base",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//base:i18n",
    "//third_party/icu",
    "//uw/browser/agent:chat_notification",
    "//uw/browser/agent:scheduled_chats",
    "//uw/browser/agent:skill_folders",
    "//uw/browser/connectors",
    "//uw/browser/ai_providers",
    "//uw/browser/resources/uw_chat:resources",
    "//uw/browser/tab_organization",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/terminal",
    "//uw/components/agent",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "uw_chat_browsertest.cc" ]
  data_deps = [ "//uw/browser/connectors:uw_fake_mcp_server" ]
  deps = [
    ":uw_chat",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/actor",
    "//chrome/browser/actor:test_support",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/notifications:test_support",
    "//chrome/browser/optimization_guide:test_support",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//components/optimization_guide/core",
    "//components/prefs",
    "//components/tabs:public",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//ui/message_center/public/cpp",
    "//ui/views",
    "//url",
    "//uw/browser/agent",
    "//uw/browser/agent:chat_tab",
    "//uw/browser/agent:scheduled_chats",
    "//uw/browser/agent:skill_folders",
    "//uw/browser/agent:test_support",
    "//uw/browser/connectors",
    "//uw/browser/ai_providers",
    "//uw/browser/ai_providers:test_support",
    "//uw/browser/tab_organization",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/tab_organization:test_support",
    "//uw/browser/terminal",
    "//uw/browser/ui/views/tab_organization",
    "//uw/components/agent",
    "//uw/components/ai_providers",
  ]
}
