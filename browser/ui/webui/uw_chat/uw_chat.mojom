module uw.mojom;

interface ChatHandlerFactory {
  CreateHandler(pending_remote<ChatPage> page,
                pending_receiver<ChatHandler> handler);
};

interface ChatHandler {
  // The user's next message. Ignored while the agent is working.
  Send(string text);
  // Picks up a chat that stopped before it finished.
  Resume();
  // Goes to the tab of the chat `id`, or reopens it in a new tab.
  OpenChat(string id);
  // Opens a new chat in a tab of its own.
  NewChat();
  // Deletes the chat `id` and closes its tab.
  DeleteChat(string id);
  // Goes to the agent's tab `number`.
  ShowTab(int32 number);
  // Puts the chat beside the agent's tab `number`, or its latest tab when
  // `number` is 0, in split view; or ends the split when `on` is false.
  SetSideBySide(bool on, int32 number);
};

// The kinds of uw::AgentLoop::Step, and the other lines a saved chat holds.
enum StepKind {
  kTool,
  kAnswer,
  kFailed,
  // A message from the user.
  kUser,
  // The chat stopped before it finished: uw quit, or its tab closed.
  kStopped,
  // The user picked it up again.
  kResumed,
};

// One step of the agent's work.
struct Step {
  StepKind kind;
  // For a tool: its name, and what it was asked and answered, as JSON.
  string tool;
  string args;
  string result;
  // The agent's answer, what went wrong, or the user's message.
  string text;
};

// What the chat list shows beside a chat. Matches uw::ChatIndex::State.
enum ChatState {
  kDone,
  kRunning,
  kStopped,
  kUnread,
};

// A saved chat, for the chat list.
struct ChatSummary {
  string id;
  string title;
  // When it last changed, in milliseconds since the Unix epoch.
  double updated;
  ChatState state;
};

// One of the agent's tabs, for its card on the chat page.
struct AgentTab {
  int32 number;
  string title;
  string url;
  // The tab's icon, and a picture of it after the agent's last step there,
  // as data: URLs. Empty until there is one.
  string favicon;
  string picture;
  // The tab is closed. Its card stays until the chat ends.
  bool closed;
};

interface ChatPage {
  // The chat is ready: its id for the page's address, its title, and every
  // line it holds so far.
  OnOpened(string id, string title, array<Step> lines);
  OnStep(Step step);
  // Every saved chat, newest first, whenever the list changes.
  OnChats(array<ChatSummary> chats);
  // The agent's tabs, the one it acted in last, and whether the chat sits
  // beside that tab in split view, after every change.
  OnTabs(array<AgentTab> tabs, int32 current, bool side_by_side);
};
