module uw.mojom;

interface ChatHandlerFactory {
  CreateHandler(pending_remote<ChatPage> page,
                pending_receiver<ChatHandler> handler);
};

interface ChatHandler {
  // The user's next message, with up to 5 images as data: URLs. Ignored
  // while the agent is working.
  Send(string text, array<string> images);
  // Picks up a chat that stopped before it finished.
  Resume();
  // Tries the failed request again: the message that could not be sent, or
  // the model's turn that failed.
  TryAgain();
  // Goes to the tab of the chat `id`, or reopens it in a new tab.
  OpenChat(string id);
  // Opens a new chat in a tab of its own.
  NewChat();
  // Deletes the chat `id` and closes its tab.
  DeleteChat(string id);
  // Goes to the agent's tab `number`.
  ShowTab(int32 number);
  // Puts the chat beside the agent's tab `number`, or its latest tab when
  // `number` is 0, in split view; or ends the split when `on` is false.
  SetSideBySide(bool on, int32 number);
  // What a new chat suggests, written by the language model from recent
  // chats and sites. Empty until there are some.
  GetSuggestions() => (array<string> suggestions);
  // The user's answer to the last OnSkillProposal.
  AnswerSkill(bool save);
  // The user's answer to the last OnApproval. A decline may carry a note for
  // the agent.
  AnswerApproval(ApprovalChoice choice, string note);
  // Runs the chat on `model` of the provider `provider_id` from the next
  // request on, at its provider's default effort.
  SetModel(string provider_id, string model);
  // One of the chat's model's levels, or empty for its provider's default.
  SetEffort(string effort);
  // How much the chat asks from the next step on. Picked on a new chat
  // before its first message, it is also the mode new chats start on.
  SetMode(ApprovalMode mode);
  // Stops the agent: a waiting model request is dropped and a step under way
  // finishes first. Answers a waiting approval with Stop the chat.
  Stop();
  // A message while the agent works. It goes in after the step under way;
  // while a step waits for approval it declines that step, as its note.
  Steer(string text, array<string> images);
  // The connectors that are on, and whether this chat uses each.
  GetConnectors() => (array<ChatConnector> connectors);
  // Turns a connector off or on for this chat from the next step.
  SetConnectorOn(string name, bool on);
  // Sends a connector's prompt, with `values` for its arguments, as the
  // user's message. The chat shows it as `shown`.
  SendPrompt(string connector,
             string prompt,
             map<string, string> values,
             string shown);
  // Whether the chat's model sees images, which the page knows from the
  // model list.
  SetSeesImages(bool sees);
  // What a new schedule card starts with: the chat's first message, daily at
  // 9:00 in the Mac's time zone, change alerts, the model last picked on a
  // schedule card or else the chat's, and the chat's approval mode.
  NewSchedule() => (ScheduleState state);
  // Saves the schedule card. A new schedule runs at once.
  SaveSchedule(ChatSchedule schedule);
  // Takes the chat's schedule off. The chat stays.
  RemoveSchedule();
  // Pausing stops runs; resuming does not catch up on the paused time.
  SetSchedulePaused(bool paused);
  SetScheduleMuted(bool muted);
  // Ends the run under way.
  StopRun();
  // Pauses, or resumes, every scheduled chat of the profile.
  PauseAllSchedules(bool paused);
};

// The model a chat runs on, from a provider on uw://ai/providers.
struct ChatModel {
  string provider_id;
  string model;
  // Empty for the provider's default.
  string effort;
};

// The kinds of uw::AgentLoop::Step, and the other lines a saved chat holds.
enum StepKind {
  kTool,
  kAnswer,
  kFailed,
  // A message from the user.
  kUser,
  // The chat stopped before it finished: uw quit, or its tab closed.
  kStopped,
  // The user picked it up again.
  kResumed,
  // The user switched the chat's model or its effort.
  kModel,
  // The user stopped the chat, with Stop or from an approval.
  kStoppedByUser,
  // A run of the chat's schedule, which `run` describes.
  kRun,
  // Times a run of the chat's schedule let go by while it waited for the
  // user. `text` says how many.
  kRunSkipped,
};

// How a run of a scheduled chat ended.
enum RunEnd {
  kReported,
  // It ended without a report. It counts toward the pause after three.
  kFailed,
  // It could not reach its model. It does not count.
  kUnreachable,
  kStopped,
};

// A run of a scheduled chat, as its line shows it.
struct RunLine {
  // When it ran, in milliseconds since the Unix epoch.
  double time;
  RunEnd end;
  // Whether it found what the user asked to hear about.
  bool found;
  // What its notification said under the chat's title, such as "Change
  // alert", or empty when it sent none.
  string what;
  // Its tracked values as a person reads them, such as "price 479 USD".
  array<string> values;
  // Its steps, folded under the line, such as "read tab 1".
  array<string> steps;
  // Whether it counted toward the pause, and whether it paused the schedule.
  bool counted;
  bool paused;
};

// One step of the agent's work.
struct Step {
  StepKind kind;
  // For a tool: its name, and what it was asked and answered, as JSON.
  string tool;
  string args;
  string result;
  // The agent's answer, what went wrong, or the user's message.
  string text;
  // For kModel: the model the chat runs on from there.
  ChatModel? model;
  // For kUser: the images the message carried, as data: URLs.
  array<string> images;
  // For kRun: the run. `text` holds what it reported, or what went wrong.
  RunLine? run;
};

// How often a scheduled chat runs. Matches uw::Schedule::Repeat.
enum ScheduleRepeat {
  kEveryHours,
  kDaily,
  kWeekdays,
  kWeekly,
  kOnce,
};

// A scheduled chat's settings, as its schedule card shows and saves them.
struct ChatSchedule {
  ScheduleRepeat repeat;
  // For kEveryHours: 1, 2, 3, 4, 6, or 12.
  int32 hours;
  // The wall time for kDaily, kWeekdays, and kWeekly, and for kWeekly its
  // day, 0 for Sunday.
  int32 hour;
  int32 minute;
  int32 weekday;
  // For kOnce: when, in milliseconds since the Unix epoch.
  double once;
  // An IANA time zone, or empty for the Mac's own, wherever it is.
  string time_zone;
  // What each run is asked.
  string request;
  bool regular_updates;
  bool even_when_nothing_changes;
  // The model runs use.
  ChatModel model;
  ApprovalMode mode;
};

// How a scheduled chat stands, for the strip under its title.
struct ScheduleState {
  ChatSchedule schedule;
  // The time zone its wall times are in, as a person reads it, such as
  // "Los Angeles".
  string zone_name;
  // The next run, or 0 when there is none, and the last, in milliseconds
  // since the Unix epoch.
  double next;
  double last;
  // What the last run found, such as "Still above $500, price 549 USD".
  string last_text;
  bool paused;
  bool muted;
  bool running;
  // A step of the run waits for the user.
  bool waiting;
  // Why uw paused it after three failed runs, and the site that wanted a
  // sign-in on the last run, if any.
  string pause_reason;
  string sign_in;
};

// What the chat list shows beside a chat. Matches uw::ChatIndex::State.
enum ChatState {
  kDone,
  kRunning,
  // Waiting for the user to approve a step.
  kWaiting,
  kStopped,
  kUnread,
};

// A saved chat, for the chat list.
struct ChatSummary {
  string id;
  string title;
  // When it last changed, in milliseconds since the Unix epoch.
  double updated;
  ChatState state;
  // For a scheduled chat: its next run, in milliseconds since the Unix epoch,
  // or 0 when it has none, and whether it is paused.
  double next_run;
  bool scheduled;
  bool schedule_paused;
};

// A step that waits for the user's approval: its tab and site, what it does,
// and why it needs approval. A terminal step has its folder in place of a
// site, and its command, or the text and keys it sends with what the
// program last showed.
struct Approval {
  int32 tab;
  string site;
  string action;
  string reason;
  string folder;
  string command;
  string text;
  array<string> keys;
  string screen;
  // A connector's tool, with the arguments the model sent as JSON. Always
  // allow is not offered in a private chat.
  string connector;
  string tool;
  string arguments;
  bool can_always_allow;
  // A terminal step that may read a sensitive file, and the file, when the
  // command check named it.
  bool sensitive;
  string file;
};

enum ApprovalChoice {
  kApprove,
  kDecline,
  kStop,
  // For a connector's tool: no more asking for the rest of the chat, or
  // ever.
  kAllowForChat,
  kAlwaysAllow,
};

// How a connector stands, as the "+" menu shows it.
enum ChatConnectorState {
  kReady,
  kStarting,
  kNeedsSignIn,
  kFailed,
};

struct PromptArgument {
  string name;
  string description;
  bool required;
};

// A prompt a connector offers in the / menu.
struct ChatPrompt {
  string name;
  string description;
  array<PromptArgument> arguments;
};

// A connector that is on, and whether this chat uses it.
struct ChatConnector {
  string name;
  bool on;
  ChatConnectorState state;
  array<ChatPrompt> prompts;
};

// Matches uw::ApprovalMode.
enum ApprovalMode {
  kAskFirst,
  kAuto,
  kFullAuto,
};

// A skill the agent wrote in a chat, waiting for the user to save it.
struct SkillProposal {
  string name;
  string description;
  string instructions;
};

// One of the agent's tabs, for its card on the chat page.
struct AgentTab {
  int32 number;
  string title;
  string url;
  // The tab's icon, and a picture of it after the agent's last step there,
  // as data: URLs. Empty until there is one.
  string favicon;
  string picture;
  // The tab is closed. Its card stays until the chat ends.
  bool closed;
  // A terminal tab, whose card shows the last lines of its screen in place
  // of a picture.
  bool terminal;
  string screen;
};

interface ChatPage {
  // The chat is ready: its id for the page's address, its title, and every
  // line it holds so far.
  OnOpened(string id, string title, array<Step> lines);
  // The model the chat runs on, after OnOpened and after every change.
  // Nothing when no model is picked anywhere.
  OnModel(ChatModel? model);
  // The chat's approval mode, after OnOpened and after every change.
  OnMode(ApprovalMode mode);
  OnStep(Step step);
  // Every saved chat, newest first, whenever the list changes.
  OnChats(array<ChatSummary> chats);
  // The agent's tabs, the one it acted in last, and whether the chat sits
  // beside that tab in split view, after every change.
  OnTabs(array<AgentTab> tabs, int32 current, bool side_by_side);
  // The chat was opened to ask `text`, from the command bar. The page sends
  // it as if typed.
  OnAsk(string text);
  // The agent asks to save a new skill. AnswerSkill gives the user's answer.
  OnSkillProposal(SkillProposal proposal);
  // A step waits for the user. AnswerApproval gives the answer. Only the
  // user answers it: nothing on a page does.
  OnApproval(Approval approval);
  // `program` in the agent's terminal tab `tab` waits for a password, which
  // only the user types there; or with 0, nothing waits any more.
  OnPassword(int32 tab, string program);
  // `command` runs in the agent's terminal tab `tab` while its step waits
  // for it; or with 0, no step waits for a command any more.
  OnRunning(int32 tab, string command);
  // A connector changed: added, removed, turned on or off, or started.
  OnConnectorsChanged();
  // The chat's schedule and how it stands, after OnOpened and after every
  // change. Nothing when it has none.
  OnSchedule(ScheduleState? state);
};

// The watch card, under the eye in the address bar: the page of the tab it
// opened for, and the scheduled chat that watches it, if one does. See
// docs/product.md, "Scheduled chats".
struct WatchCardState {
  string title;
  // The site, such as "fully.com".
  string host;
  // The page's icon as a data: URL, or empty.
  string favicon;
  // The chat that watches the page, or empty when none does.
  string chat_id;
  // What the card's chip asked for, such as "Price drops below $500", or
  // empty for the user's own words.
  string watch_for;
  // The watch's schedule and how it stands, or a new card's settings.
  ScheduleState state;
};

// Links the watch card's page to its handler.
interface WatchCardHandlerFactory {
  CreateWatchCardHandler(pending_remote<WatchCardPage> page,
                         pending_receiver<WatchCardHandler> handler);
};

// Browser side. Only the watch card's page can reach it.
interface WatchCardHandler {
  // The page has drawn and can be shown.
  ShowUI();
  // Watches the page on `schedule`, which asks `schedule.request`, or saves
  // the watch's changed schedule. Then closes the card.
  Watch(ChatSchedule schedule, string watch_for);
  // Removes the watch's schedule and closes the card. Its chat stays.
  StopWatching();
  // Shows the watch's chat and closes the card.
  OpenChat();
  Close();
};

// The watch card's page.
interface WatchCardPage {
  // What the card shows: once it connects, and again whenever the watch
  // changes.
  OnCard(WatchCardState card);
};
