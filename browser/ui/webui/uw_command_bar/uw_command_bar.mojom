module uw.mojom;

// The European Central Bank's reference rates for one day: how much of each
// currency one euro buys.
struct ExchangeRates {
  // The day the bank set them, as YYYY-MM-DD.
  string date;
  map<string, double> per_euro;
};

// The web page selected behind the command bar, which a typed "@" asks about.
struct SelectedPage {
  string title;
  string url;
};

// A command the command bar can run now, with its key, one cap per part,
// such as ["Option", "Cmd", "S"].
struct BarCommand {
  int32 id;
  string name;
  array<string> keys;
};

// A task of the window's workspace, or the Scratchpad.
struct BarTask {
  // The task's key, empty for the Scratchpad.
  string id;
  string name;
  // The folder's color, as CSS, empty for the Scratchpad.
  string color;
  int32 tab_count;
  // The addresses its tabs show, which name the task of a tab row.
  array<string> urls;
};

struct BarTasks {
  // The tasks in sidebar order, then the Scratchpad.
  array<BarTask> tasks;
  // The selected tab's task, empty for the Scratchpad.
  string selected;
  // True when the command bar opened to move the selected tabs, as
  // Option+Cmd+M does.
  bool moving;
};

// What the command bar's page asks of its window.
interface CalculatorHandler {
  // The last rates uw downloaded, if any, and the currency a bare amount
  // converts to. Downloads the day's rates when the last are a day old.
  GetCurrencies() => (ExchangeRates? rates, string currency);
  // The Mac's time zone, as in "Asia/Hong_Kong", and whether it shows times
  // on a 24-hour clock. The page's own Intl does not see that switch.
  GetClock() => (string time_zone, bool twenty_four_hour);
  // Copies an answer and closes the command bar.
  CopyAnswer(string text);
  // Closes the command bar, as Escape on an empty field does.
  Close();
  // Whether the bar is frosted glass this time it shows: its window's glass
  // is on.
  IsFrosted() => (bool frosted);
  // The page selected behind the command bar, or null when the selected tab
  // does not show a web page.
  GetSelectedPage() => (SelectedPage? page);
  // Asks `text` in a new chat, with the selected page handed to the agent.
  AskAboutPage(string text);
  // The commands that can run now, and the workspace's tasks.
  GetCommands() => (array<BarCommand> commands);
  GetTasks() => (BarTasks tasks);
  // Each closes the command bar first, but Move to Task…, which lists the
  // tasks in it. A command runs on the selected tab.
  RunCommand(int32 id);
  // Selects the tab used last in task `id`, or in the Scratchpad.
  GoToTask(string id);
  // Moves the selected tabs, each with the tabs under it, to the end of task
  // `id`, or of the Scratchpad, or to a new task.
  MoveToTask(string id);
  MoveToNewTask();
};
