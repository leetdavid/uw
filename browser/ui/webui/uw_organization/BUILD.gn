# Mojo backend for the uw organization section of chrome://settings.
# Profile-scoped (prefs plus the profile Keychain slot); it never touches
# window state.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "uw_organization.mojom" ]
  webui_module_path = "/"
}

source_set("uw_organization_handler") {
  sources = [
    "uw_organization_handler.cc",
    "uw_organization_handler.h",
  ]
  public_deps = [
    ":mojo_bindings",
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]
  deps = [
    "//chrome:strings",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/themes",
    "//components/prefs",
    "//net",
    "//skia",
    "//ui/base",
    "//ui/base/mojom",
    "//url",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/components/agent",
    "//uw/components/look",
    "//uw/components/tab_organization",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "uw_organization_page_browsertest.cc" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome:strings",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/themes",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//components/prefs",
    "//content/test:test_support",
    "//net:test_support",
    "//skia",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//ui/color",
    "//ui/gfx:color_utils",
    "//url",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/tab_organization:test_support",
    "//uw/components/look",
  ]
}
