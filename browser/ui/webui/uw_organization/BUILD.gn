# Mojo backend for the uw organization section of chrome://settings.
# Profile-scoped prefs. Its one window action opens the theme picker.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "uw_organization.mojom" ]
  webui_module_path = "/"
}

source_set("uw_organization_handler") {
  sources = [
    "uw_organization_handler.cc",
    "uw_organization_handler.h",
  ]
  public_deps = [
    ":mojo_bindings",
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]
  deps = [
    "//chrome:strings",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
    "//components/prefs",
    "//ui/base",
    "//uw/browser/ai_providers",
    "//uw/browser/tab_organization",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/ui/webui/uw_command_bar",
    "//uw/components/tab_organization",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "uw_organization_page_browsertest.cc" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//chrome:strings",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//components/prefs",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//url",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/tab_organization:test_support",
    "//uw/browser/ui/views/theme_picker",
    "//uw/components/ai_providers",
  ]
}
