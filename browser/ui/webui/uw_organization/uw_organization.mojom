module uw.mojom;

// How sure a model must be before uw moves a tab, starts a task, or renames
// one. See uw::Thresholds.
struct Thresholds {
  double move;
  double new_task;
  double rename;
};

// Why automatic organization does not run while it is turned on. The models
// are picked on uw://providers.
enum Waiting {
  kNothing,
  // Neither a language model nor a decision model is picked.
  kNoModel,
};

struct State {
  // Whether the user turned automatic organization on.
  bool enabled;
  Waiting waiting;
  // The models the status line names. Empty when that model is not set.
  string decision_model;
  string language_model;
  // Matches uw::PauseMode.
  int32 pause_mode;
  Thresholds thresholds;
  // Whether this Mac can show glass, and whether windows behind the front one
  // keep theirs.
  bool can_show_glass;
  bool glass_behind;
  // Whether Cmd+T opens the command bar.
  bool command_bar;
  // The currency a bare amount in the command bar converts to, as a code.
  // Empty follows the Mac's region, whose currency is region_currency.
  string currency;
  string region_currency;
  // The currencies the last exchange rates cover.
  array<string> currencies;
  // The switches of the tab list's mouse actions.
  bool option_click_closes_branch;
  bool task_row_new_tab;
  bool double_click_opens_tab;
  bool middle_click_closes_task;
  // The mini player's settings, for all of uw.
  MiniPlayerMode mini_player_mode;
  bool mini_player_on_tab_switch;
  bool mini_player_float_in_background;
  // The sites that have opened their own picture-in-picture window, newest
  // first.
  array<LiveSite> live_sites;
};

// A site that has opened its own picture-in-picture window, and whether that
// window keeps running beside a video.
struct LiveSite {
  string site;
  bool live;
};

// The tab list's mouse actions that have a switch.
enum MouseAction {
  kOptionClickClosesBranch,
  kTaskRowNewTab,
  kDoubleClickOpensTab,
  kMiddleClickClosesTask,
};

// Where picture in picture goes, uw::MiniPlayerMode.
enum MiniPlayerMode {
  kDock,
  kDontDock,
  kOff,
};

// The mini player's switches.
enum MiniPlayerSwitch {
  kOnTabSwitch,
  kFloatInBackground,
};

struct PauseResult {
  int32 pause_mode;
};

// Why installing or uninstalling the uw command didn't finish.
enum CommandProblem {
  kNone,
  // The user closed macOS's password prompt.
  kCancelled,
  kFailed,
};

// The uw command's section on Settings, System. See docs/plans/uw-command.md.
struct CommandState {
  bool installed;
  // Where the command is linked: /usr/local/bin/uw.
  string link;
  CommandProblem problem;
};

// Profile-scoped backend for the uw page of chrome://settings.
interface OrganizationHandler {
  GetState() => (State state);
  SetEnabled(bool on) => (State state);
  SetPause(int32 mode) => (PauseResult result);
  // Takes effect with the next answer. A value outside the range counts as
  // the nearest one in it. Returns what was stored.
  SetThresholds(Thresholds thresholds) => (Thresholds thresholds);

  // Opens the theme picker in the window that shows the page.
  OpenThemePicker();
  // For all of uw. Every window follows at once.
  SetGlassBehind(bool on) => ();
  // Every window follows at once.
  SetCommandBar(bool on) => ();
  // Empty follows the Mac's region. A code the rates do not cover is ignored.
  SetCurrency(string code) => ();
  // Every window follows at once.
  SetMouseAction(MouseAction action, bool on) => ();
  // For all of uw. A mini player that shows moves at once.
  SetMiniPlayerMode(MiniPlayerMode mode) => ();
  SetMiniPlayer(MiniPlayerSwitch which, bool on) => ();
  SetSiteLive(string site, bool live) => ();
  // For all of uw. Installing links the command, through macOS's password
  // prompt when needed, and opens uw's channel for it; uninstalling closes it.
  GetCommand() => (CommandState state);
  InstallCommand() => (CommandState state);
  UninstallCommand() => (CommandState state);
};
