# The uw://ai page's browser side. Its page is built with the chat page; see
# //uw/browser/resources/uw_chat.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "uw_providers.mojom" ]
  webui_module_path = "/"
}

source_set("uw_providers") {
  sources = [
    "uw_providers_handler.cc",
    "uw_providers_handler.h",
    "uw_providers_ui.cc",
    "uw_providers_ui.h",
  ]
  public_deps = [
    ":mojo_bindings",
    "//base",
    "//uw/browser/problem_reports",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//ui/webui",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/ai_providers",
    "//uw/components/ai_providers",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/navigator",
    "//components/prefs",
    "//components/tabs:public",
    "//content/public/common",
    "//net",
    "//services/network/public/cpp",
    "//ui/base",
    "//url",
    "//uw/browser/agent:chat_tab",
    "//uw/browser/agent:chats",
    "//uw/browser/agent:memory_store",
    "//uw/browser/agent:skill_folders",
    "//uw/browser/connectors",
    "//uw/browser/resources/uw_chat:resources",
    "//uw/browser/terminal",
    "//uw/components/agent",
    "//uw/components/tab_organization",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "uw_providers_browsertest.cc" ]
  data_deps = [ "//uw/browser/connectors:uw_fake_mcp_server" ]
  deps = [
    ":uw_providers",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser:platform_util_internal",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//components/prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//net:test_support",
    "//services/network/public/cpp",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
    "//uw/browser/tab_organization:ai_connection",
    "//uw/browser/ai_providers",
    "//uw/browser/agent:chats",
    "//uw/browser/agent:memory_store",
    "//uw/browser/agent:skill_folders",
    "//uw/browser/ai_providers:test_support",
    "//uw/browser/connectors",
    "//uw/browser/terminal",
    "//uw/browser/tab_organization:test_support",
    "//uw/components/ai_providers",
  ]
}
