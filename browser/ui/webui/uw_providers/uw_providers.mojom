module uw.mojom;

// Matches uw::ProviderFormat.
enum ProviderFormat {
  kChatCompletions,
  kAnthropicMessages,
  kOpenAiResponses,
  kOpenAiDecisions,
  kSystemOne,
  kEachModel,
};

// Matches uw::ProviderPreset.
enum ProviderPreset {
  kCustom,
  kOpenAi,
  kAnthropic,
  kOpenRouter,
  kVercelAiGateway,
  kOllama,
  kJev,
};

// Matches uw::ModelSlot.
enum ModelSlot {
  kLanguage,
  kDecision,
  kAgent,
};

// A saved provider as the page shows it. Its key never reaches the page.
struct Provider {
  string id;
  ProviderPreset preset;
  string name;
  string address;
  ProviderFormat format;
  bool has_key;
  // Whether it can serve the language and agent models.
  bool serves_language;
  // Whether it can serve the decision model.
  bool serves_decisions;
};

struct ModelChoice {
  string provider_id;
  string model;
  // Empty for the provider's default.
  string effort;
};

// A model as its provider lists it, with what the models.dev catalog, or
// Ollama's own details, say it can do.
struct Model {
  string name;
  bool calls_tools;
  // Whether it takes images, as the catalog or Ollama says. True when
  // neither knows.
  bool sees_images;
  // Named as its provider names them. Empty when it takes none.
  array<string> efforts;
  // The format requests to it go over.
  ProviderFormat format;
};

// Matches uw::UpgradeNotice.
enum UpgradeNotice {
  kNone,
  kMoved,
  kMerged,
  kFailed,
};

// The address a preset fills in, which the user can change.
struct PresetAddress {
  ProviderPreset preset;
  string address;
};

struct ProvidersState {
  array<Provider> providers;
  array<PresetAddress> preset_addresses;
  ModelChoice? language;
  ModelChoice? decision;
  // Null while chats use the language model.
  ModelChoice? agent;
  // What the page says once after the saved connections became providers.
  UpgradeNotice upgrade_notice;
};

// A provider as the user enters it in the Add provider dialog. A preset
// brings its own name and format, and its address unless one is given.
struct NewProvider {
  ProviderPreset preset;
  string name;
  string address;
  ProviderFormat format;
  // Empty for a provider that takes none.
  string api_key;
};

struct ModelList {
  bool ok;
  // Without embedding, speech, image, and moderation models.
  array<Model> models;
  // What went wrong when `ok` is false, in the provider's words when it
  // gave any.
  string error;
};

enum TestOutcome {
  kPassed,
  // The model, its provider, or the provider's key is missing.
  kIncomplete,
  kNoResponse,
  kHttpError,
  // The model answered with something other than text or a choice.
  kUnusable,
};

// What one test request found. The page writes the sentence.
struct ModelTestResult {
  TestOutcome outcome;
  string model;
  string host;
  int32 http_status;
  // A net error such as ERR_CONNECTION_REFUSED.
  string net_error;
  // The provider's own words about an error, when its answer has any.
  string provider_message;
  double seconds;
  // What uw sent and what came back. Never an API key.
  string detail;
};

// Where a skill comes from. Matches uw::Skill::Source.
enum SkillSource {
  kUw,
  kAgents,
  kChat,
};

struct SkillInfo {
  string name;
  string description;
  SkillSource source;
  bool on;
  // Whether the agent may pick it, and whether the user may start it by
  // typing / and its name.
  bool for_agent;
  bool for_user;
  // What to type after its name.
  string argument_hint;
};

// How a connector stands. Matches uw::Connectors::State.
enum ConnectorState {
  kOff,
  kStarting,
  kReady,
  kNeedsSignIn,
  kSigningIn,
  kCantSignIn,
  kFailed,
};

struct ConnectorTool {
  string name;
  string description;
  // The server says it only reads.
  bool read_only;
  bool on;
  bool always_allowed;
};

struct ConnectorPrompt {
  string name;
  string description;
};

// A connector as uw://ai/connectors shows it.
struct ConnectorInfo {
  string name;
  bool remote;
  // Its address, or the command uw starts.
  string address;
  bool on;
  ConnectorState state;
  // Why it failed, or what it last said.
  string error;
  // The MCP version it speaks, once it has answered.
  string version;
  array<ConnectorTool> tools;
  array<ConnectorPrompt> prompts;
  // The names of its secrets, whose values stay in Keychain.
  array<string> secret_names;
  // The last lines of a failed local connector's log.
  array<string> log_lines;
};

// A connector in pasted JSON, before it is added.
struct NewConnector {
  string name;
  bool remote;
  string address;
  array<string> secret_names;
};

// Profile-scoped backend of uw://ai, and of the chat page's model chips.
interface ProvidersHandler {
  GetState() => (ProvidersState state);
  ListModels(string provider_id) => (ModelList list);
  // Lists the models at an address before the provider is added.
  ListModelsAt(NewProvider provider) => (ModelList list);
  // Returns the new provider's id, or nothing when its address is not
  // usable.
  AddProvider(NewProvider provider) => (string? id);
  // An empty key is ignored.
  ReplaceKey(string provider_id, string api_key) => ();
  // Moves the provider to `address` once its models list there. Returns the
  // list, which says why when the move did not happen.
  ChangeAddress(string provider_id, string address) => (ModelList list);
  // Removes its key from the Keychain. Model choices that used it stay, and
  // wait for the user to pick another model.
  RemoveProvider(string provider_id) => ();
  // Ignored when the provider cannot serve that slot.
  PickModel(ModelSlot slot, string provider_id, string model) => ();
  // Leaves the decision model unset, or chats on the language model.
  ClearModel(ModelSlot slot) => ();
  // One of the slot's model's levels, or empty for its provider's default.
  SetEffort(ModelSlot slot, string effort) => ();
  // Sends the language or decision model one small request. A pass marks
  // the model tested.
  TestModel(ModelSlot slot) => (ModelTestResult result);
  DismissUpgradeNotice() => ();
  // Every skill the agent can use.
  GetSkills() => (array<SkillInfo> skills);
  // Turns the skill `name` on or off for every chat.
  SetSkillOn(string name, bool on);
  // Shows uw's skills folder in Finder, making it first if need be.
  OpenSkillsFolder();
  // Shows uw://ai/<section> in this window: in its uw://ai tab if one is
  // open, or in a new tab.
  ShowAiPage(string section);

  // The problem, when there is one, is why programs on this Mac start
  // without the terminal's environment.
  GetConnectors() => (array<ConnectorInfo> connectors,
                      string environment_problem);
  // Answers the next time a connector changes.
  WaitForConnectorChange() => ();
  // What pasted JSON holds, or what is wrong with it.
  ReadConnectors(string json) => (array<NewConnector> connectors,
                                  string error);
  // Adds what the JSON holds and starts it. An address of the old HTTP+SSE
  // transport is tried at /mcp first. An empty error means it worked.
  AddConnectors(string json) => (string error);
  RemoveConnector(string name);
  SetConnectorOn(string name, bool on);
  SetConnectorToolOn(string name, string tool, bool on);
  SetToolAlwaysAllowed(string name, string tool, bool allowed);
  // Starts a failed connector again.
  RestartConnector(string name);
  // Opens the connector's sign-in page in a new tab.
  SignInConnector(string name);
  CancelSignIn(string name);
  SignOutConnector(string name);
  // Opens a terminal tab running a local connector's command, with its
  // environment.
  OpenConnectorInTerminal(string name);
  // Opens a local connector's log in a new tab.
  ShowConnectorLog(string name);
};
