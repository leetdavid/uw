module uw.mojom;

// Links the uw://terminal page to the shell behind its tab.
interface TerminalHandlerFactory {
  CreateHandler(pending_remote<TerminalPage> page,
                pending_receiver<TerminalHandler> handler);
};

// Browser side. Only the uw://terminal page can reach it.
interface TerminalHandler {
  // Starts the user's shell at this size. Only the first call counts.
  Start(int32 columns, int32 rows);

  // What the user typed, pasted, or dropped, and the terminal's own answers
  // to what the shell asked it.
  Write(string text);

  Resize(int32 columns, int32 rows);

  // The page has drawn the last output and can take more.
  AckOutput();

  // What a paste of files or an image types: the files on the clipboard as
  // their paths, quoted for the shell. An image with no file and no text is
  // first saved to a new temporary file. Empty when the page should paste the
  // text instead.
  PastePaths() => (string paths);
};

// Page side.
interface TerminalPage {
  // What the shell printed. No more arrives until the page calls AckOutput.
  Output(string text);

  // The name of the folder the shell is in.
  SetFolder(string name);
};
