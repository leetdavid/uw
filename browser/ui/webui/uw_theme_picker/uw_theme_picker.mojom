module uw.mojom;

// Chromium's color mode: Auto follows macOS.
enum ColorMode {
  kAuto,
  kLight,
  kDark,
};

// The profile's theme, as the picker shows it.
struct Theme {
  // One to three colors as 0xAARRGGBB, in the order they were added.
  array<uint32> colors;
  // How much of each color's saturation shows, from 0 to 100.
  int32 intensity;
  // How strong the grain over the theme is, from 0 to 100.
  int32 grain;
  // How much of the desktop shows through the window, from 0, solid, to 100.
  int32 transparency;
  // How glassy the window's tiles and buttons are, from 0, flat, to 100.
  int32 glass;
  bool colors_in_dark_mode;
};

// Why the window is solid and its tiles flat while the sliders ask for glass.
enum GlassPause {
  kNone,
  kEnergySaver,
  kReduceTransparency,
};

// The Transparency and Glass sliders: whether this Mac can show glass, where
// the Transparency tick sits past which text may stop reading, from 0 to 100,
// and why glass is paused.
struct GlassSliders {
  bool shown;
  int32 readable_transparency;
  GlassPause pause;
};

// Links the theme picker page to its handler.
interface ThemePickerHandlerFactory {
  CreateHandler(pending_receiver<ThemePickerHandler> handler);
};

// Browser side. Only the theme picker page can reach it.
interface ThemePickerHandler {
  // The theme, the color mode, the suggested themes, each one to three
  // colors, and the glass sliders.
  GetState() => (Theme theme, ColorMode mode, array<array<uint32>> suggested,
                 GlassSliders glass);

  // The glass sliders for `theme` in `mode`, whose colors move the tick.
  GetGlassSliders(Theme theme, ColorMode mode) => (GlassSliders glass);

  // Saves the theme. The window changes at once.
  SetTheme(Theme theme);

  SetMode(ColorMode mode);

  // The page has drawn and can be shown.
  ShowUI();
};
