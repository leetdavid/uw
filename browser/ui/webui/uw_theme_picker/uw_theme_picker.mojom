module uw.mojom;

// The light or dark of everything outside the sidebar: the theme's own, Light,
// or Dark.
enum PageMode {
  kTheme,
  kLight,
  kDark,
};

// The profile's theme, as the picker shows it.
struct Theme {
  // One to three colors as 0xAARRGGBB, in the order they were added.
  array<uint32> colors;
  // How much of each color's chroma shows, from 0 to 100.
  int32 intensity;
  // How much of each color's lightness shows, from 0, black, to 100.
  int32 brightness;
  // How strong the grain over the theme is, from 0 to 100.
  int32 grain;
  // How much of the desktop shows through the window, from 0, solid, to 100.
  int32 transparency;
  // How glassy the window's tiles and buttons are, from 0, flat, to 100.
  int32 glass;
};

// One of the suggested themes, with its colors as the window would show them.
struct SuggestedTheme {
  array<uint32> colors;
  int32 brightness;
  array<uint32> shown;
};

// A point of the color field, each axis from 0 to 1.
struct FieldPoint {
  float x;
  float y;
};

// Why the window is solid and its tiles flat while the sliders ask for glass.
enum GlassPause {
  kNone,
  kEnergySaver,
  kReduceTransparency,
};

// The Transparency and Glass sliders: whether each shows, where the
// Transparency tick sits past which text may stop reading, from 0 to 100, and
// why glass is paused. Transparency shows where the system can draw glass
// behind windows, which the picker's own frost needs too.
struct GlassSliders {
  bool transparency_shown;
  bool glass_shown;
  int32 readable_transparency;
  GlassPause pause;
};

// Links the theme picker page to its handler.
interface ThemePickerHandlerFactory {
  CreateHandler(pending_receiver<ThemePickerHandler> handler);
};

// Browser side. Only the theme picker page can reach it.
interface ThemePickerHandler {
  // The theme, each of its colors as the window shows it and where it sits on
  // the color field, the page mode, the suggested themes, and the glass
  // sliders.
  GetState() => (Theme theme, array<uint32> shown, array<FieldPoint> points,
                 PageMode page_mode, array<SuggestedTheme> suggested,
                 GlassSliders glass);

  // The color under `point` of the color field.
  ColorAt(FieldPoint point) => (uint32 color);

  // Where on the color field each of `colors` sits.
  PointsOf(array<uint32> colors) => (array<FieldPoint> points);

  // Saves the theme. The window changes at once. Answers with each color as
  // the window shows it and the glass sliders, whose tick moves with them.
  SetTheme(Theme theme) => (array<uint32> shown, GlassSliders glass);

  // Open pages change at once.
  SetPageMode(PageMode mode);

  // The page has drawn and can be shown.
  ShowUI();
};
