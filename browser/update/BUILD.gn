# Sparkle updates behind Chromium's relaunch button on the Mac, and uw's own
# fetcher behind it on Windows. See ADR 0019 and ADR 0026.

# Kept apart from Sparkle, so Chromium's updater stub can ask about a pending
# update without pulling in browser code.
source_set("pending_update") {
  sources = [
    "pending_update.cc",
    "pending_update.h",
  ]
  deps = [ "//base" ]
}

source_set("update") {
  public_deps = [ ":pending_update" ]
  if (is_mac) {
    sources = [
      "sparkle_updater.h",
      "sparkle_updater.mm",
    ]
    deps = [
      "//base",
      "//chrome/browser:browser_process",
      "//chrome/browser/upgrade_detector",
    ]
    frameworks = [ "Foundation.framework" ]
  } else if (is_win) {
    sources = [
      "windows_updater.cc",
      "windows_updater.h",
    ]
    deps = [
      "//base",
      "//base/version_info",
      "//chrome/browser:browser_process",
      "//chrome/browser/first_run",
      "//chrome/browser/lifetime",
      "//chrome/common:constants",
      "//chrome/installer/util:with_no_strings",
      "//crypto",
      "//net",
      "//services/network/public/cpp",
      "//third_party/boringssl",
      "//url",
      "//uw/browser/branding:release_buildflags",
    ]
  }
}

source_set("windows_browser_tests") {
  testonly = true
  sources = [ "windows_updater_browsertest.cc" ]
  deps = [
    ":update",
    "//base",
    "//testing/gtest",
    "//third_party/boringssl",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "update_browsertest.cc" ]
  deps = [
    ":update",
    "//base",
    "//base/version_info",
    "//chrome/browser",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/lifetime",
    "//chrome/browser/updater",
    "//chrome/browser/upgrade_detector",
    "//chrome/common",
    "//chrome/test:test_support",
    "//components/prefs",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}
