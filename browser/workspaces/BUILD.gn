# Workspaces and the windows that show them. See docs/plans/workspaces.md.
source_set("workspaces") {
  sources = [
    "workspace_commands.h",
    "workspace_list.cc",
    "workspace_list.h",
    "workspace_window.cc",
    "workspace_window.h",
    "workspace_theme.cc",
    "workspace_theme.h",
    "workspace_window_mac.mm",
  ]
  frameworks = [ "AppKit.framework" ]
  public_deps = [
    "//base",
    "//chrome/browser/profiles:profile_util",
    "//components/sessions",
    "//ui/base/unowned_user_data",
    "//ui/views",
    "//uw/components/look",
  ]
  deps = [
    ":prefs",
    "//chrome/browser/themes",
    "//ui/base/mojom",
    "//ui/color",
    "//ui/native_theme",
    "//uw/browser/ui/look",
    "//uw/components/look:prefs",
    "//chrome/browser/lifetime",
    "//chrome/browser/picture_in_picture",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/sessions",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/navigator",
    "//chrome/common",
    "//components/favicon/content",
    "//components/prefs",
    "//components/tabs:public",
    "//content/public/browser",
    "//components/viz/common",
    "//ui/base",
    "//ui/compositor",
    "//ui/gfx",
    "//url",
  ]
}

# Kept apart, so registering the pref pulls in no browser code.
source_set("prefs") {
  sources = [
    "workspace_prefs.cc",
    "workspace_prefs.h",
  ]
  deps = [ "//components/prefs" ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [
    "shared_tabs_spike_browsertest.cc",
    "workspaces_browsertest.mm",
  ]
  deps = [
    ":workspaces",
    "//chrome/browser/performance_manager",
    "//chrome/browser/sessions",
    "//chrome/browser/tab_group_sync",
    "//components/saved_tab_groups/public",
    "//components/sessions",
    "//components/tab_groups",
    "//base",
    "//chrome/browser",
    "//chrome/browser/autocomplete",
    "//chrome/browser/extensions:test_support",
    "//chrome/browser:global_keyboard_shortcuts_mac",
    "//chrome/browser/headless:browser_tests",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_test_util",
    "//chrome/browser/ui",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/extensions:test_support",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui:test_support",
    "//chrome/test:test_support",
    "//components/tabs:public",
    "//components/performance_manager",
    "//components/prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//extensions:test_support",
    "//extensions/common",
    "//net:test_support",
    "//skia",
    "//testing/gtest",
    "//ui/base",
    "//ui/compositor",
    "//ui/events:test_support",
    "//ui/gfx/geometry",
    "//ui/native_theme",
    "//url",
    "//uw/browser/tab_organization",
    "//uw/browser/tab_organization:test_support",
    "//uw/browser/ui/views/tab_organization",
    "//uw/components/ai_providers",
    "//uw/components/look",
  ]
}
