+  // uw: a private profile keeps nothing. Any other closes its notifications
+  // one by one, so the ones that stay after uw quits are left.
+  if (incognito) {
+    banner_dispatcher_->CloseNotificationsWithProfileId(profile_id, incognito);
+    alert_dispatcher_->CloseNotificationsWithProfileId(profile_id, incognito);
+  }
+  for (auto it = closed_at_shutdown_.begin();
+       it != closed_at_shutdown_.end();) {
+    if (it->profile_id != profile_id || it->incognito != incognito) {
+      ++it;
+      continue;
+    }
+    banner_dispatcher_->CloseNotificationWithId(*it);
+    alert_dispatcher_->CloseNotificationWithId(*it);
+    it = closed_at_shutdown_.erase(it);
