+// uw: a chat's notification stays in Notification Center after uw quits. A
+// site's goes, and so does a step's, which has buttons.
+TEST_F(NotificationPlatformBridgeMacTest,
+       UwChatNotificationsStayAfterShutdown) {
+  auto bridge = std::make_unique<NotificationPlatformBridgeMac>(
+      CreateBannerDispatcher(), CreateAlertDispatcher(),
+      CreateWebAppDispatcherFactory());
+  std::unique_ptr<Notification> news =
+      CreateBanner("Title", "Context", "https://gmail.com", nullptr, nullptr);
+  std::unique_ptr<Notification> step = CreateBanner(
+      "Title", "Context", "https://gmail.com", "Approve", "Not this one");
+
+  bridge->Display(NotificationHandler::Type::WEB_PERSISTENT, profile(),
+                  Notification("site", *news), /*metadata=*/nullptr);
+  bridge->Display(NotificationHandler::Type::UW_CHAT, profile(),
+                  Notification("uw-chat-1", *news), /*metadata=*/nullptr);
+  bridge->Display(NotificationHandler::Type::UW_CHAT, profile(),
+                  Notification("step", *step), /*metadata=*/nullptr);
+  ASSERT_EQ(3u, banner_dispatcher()->notifications().size());
+
+  bridge->DisplayServiceShutDown(profile());
+
+  const auto& notifications = banner_dispatcher()->notifications();
+  ASSERT_EQ(1u, notifications.size());
+  EXPECT_EQ("uw-chat-1", notifications[0]->meta->id->id);
+  EXPECT_TRUE(alert_dispatcher()->notifications().empty());
+}
