 void BrowserCloseManager::CheckForDownloadsInProgress() {
 #if BUILDFLAG(IS_MAC)
+  // uw: quitting while a terminal runs a program asks first, over the window
+  // used last.
+  uw::CloseGuard* guard = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&guard](BrowserWindowInterface* window) {
+        guard = uw::CloseGuard::Get(window->GetUnownedUserDataHost());
+        return !guard;
+      });
+  if (guard &&
+      guard->HoldQuit(base::BindOnce(
+          [](scoped_refptr<BrowserCloseManager> self, bool quit) {
+            if (quit) {
+              self->CloseBrowsers();
+            } else {
+              self->CancelBrowserClose();
+            }
+          },
+          base::WrapRefCounted(this)))) {
+    return;
+  }
   // Mac has its own in-progress downloads prompt in app_controller_mac.mm.
   CloseBrowsers();
 #else
