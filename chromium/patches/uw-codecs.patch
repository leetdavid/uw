+bool AudioToolboxAudioDecoder::UseBestAacLayer(
+    const std::vector<uint8_t>& magic_cookie,
+    AudioStreamBasicDescription& format) {
+  // HE-AAC carries a fuller layer over its core, with twice the rate and, for
+  // v2, a second channel. Decode the best layer this Mac plays: its rate and
+  // channels are the decoder's output.
+  AudioFormatInfo info = {format, magic_cookie.data(),
+                          static_cast<UInt32>(magic_cookie.size())};
+  UInt32 size = 0;
+  auto status = AudioFormatGetPropertyInfo(kAudioFormatProperty_FormatList,
+                                           sizeof(info), &info, &size);
+  if (status != noErr || size < sizeof(AudioFormatListItem)) {
+    OSSTATUS_MEDIA_LOG(ERROR, status, media_log_)
+        << "AudioFormatGetPropertyInfo() failed";
+    return false;
+  }
+  std::vector<AudioFormatListItem> layers(size / sizeof(AudioFormatListItem));
+  status = AudioFormatGetProperty(kAudioFormatProperty_FormatList, sizeof(info),
+                                  &info, &size, layers.data());
+  if (status != noErr) {
+    OSSTATUS_MEDIA_LOG(ERROR, status, media_log_)
+        << "AudioFormatGetProperty() failed";
+    return false;
+  }
+  UInt32 best = 0;
+  UInt32 best_size = sizeof(best);
+  status = AudioFormatGetProperty(kAudioFormatProperty_FirstPlayableFormatFromList,
+                                  layers.size() * sizeof(AudioFormatListItem),
+                                  layers.data(), &best_size, &best);
+  format = layers[status == noErr && best < layers.size() ? best : 0].mASBD;
+  return true;
+}
