+// uw: the length of the ADTS frame `frame` starts with, or 0 when it does
+// not start with one: the sync word 0xFFF, layer 0, a known sampling rate,
+// and a length that holds at least its header.
+size_t AdtsFrameLength(base::span<const uint8_t> frame) {
+  if (frame.size() < 7 || frame[0] != 0xFF || (frame[1] & 0xF6) != 0xF0 ||
+      ((frame[2] >> 2) & 0x0F) > 12) {
+    return 0;
+  }
+  const size_t length = (frame[3] & 0x03) << 11 | frame[4] << 3 | frame[5] >> 5;
+  return length >= 7 ? length : 0;
+}
+
+}  // namespace
+
+bool FFmpegGlue::LooksLikeAdts() {
+  // A station's stream can start partway through a frame, so look for the
+  // first whole one in the first few kilobytes.
+  constexpr size_t kLookAt = 8192;
+  constexpr size_t kSearch = 4096;
+  std::vector<uint8_t> buffer(kLookAt);
+  int64_t start = 0;
+  size_t read = 0;
+  for (int tags = 0; tags < 2; ++tags) {
+    if (AVIOSeekOperation(avio_context_->opaque, start, SEEK_SET) < 0) {
+      return false;
+    }
+    read = 0;
+    while (read < kLookAt) {
+      const int got =
+          AVIOReadOperation(avio_context_->opaque,
+                            base::span(buffer).subspan(read).data(),
+                            kLookAt - read);
+      if (got <= 0) {
+        break;
+      }
+      read += got;
+    }
+    // Skip one ID3v2 tag: "ID3", then its size in four 7-bit bytes.
+    if (tags == 0 && read >= 10 && buffer[0] == 'I' && buffer[1] == 'D' &&
+        buffer[2] == '3') {
+      start = 10 + ((buffer[6] & 0x7F) << 21 | (buffer[7] & 0x7F) << 14 |
+                    (buffer[8] & 0x7F) << 7 | (buffer[9] & 0x7F)) +
+              ((buffer[5] & 0x10) ? 10 : 0);
+      continue;
+    }
+    break;
+  }
+  base::span<const uint8_t> data = base::span(buffer).first(read);
+  bool found = false;
+  for (size_t at = 0; at < kSearch && at + 7 <= data.size() && !found; ++at) {
+    const size_t length = AdtsFrameLength(data.subspan(at));
+    found = length && at + length < data.size() &&
+            AdtsFrameLength(data.subspan(at + length));
+  }
+  return AVIOSeekOperation(avio_context_->opaque, 0, SEEK_SET) >= 0 && found;
+}
