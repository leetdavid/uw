+#if BUILDFLAG(IS_MAC)
+#include "uw/browser/update/pending_update.h"
+#endif
+
 namespace updater {
 
 base::Version CurrentlyInstalledVersion() {
+#if BUILDFLAG(IS_MAC)
+  // uw: an update Sparkle has downloaded reads as an unknown installed
+  // version, which Chromium treats as an update waiting for a relaunch.
+  if (uw::HasPendingUpdate()) {
+    return base::Version();
+  }
+#endif
   return version_info::GetVersion();
 }
 
