+void BrowserViewPopupLayoutImpl::DoPostLayoutVisualAdjustments(
+    const BrowserLayoutParams& params) {
+  if (!IsLittleWindow()) {
+    return;
+  }
+  // uw: round the page card, which holds the toolbar and the page, unless it
+  // meets the window's edges.
+  const bool card =
+      !is_fullscreen(delegate().GetBrowserWindowState()) &&
+      !uw::LittleWindowMargins(g_browser_process->local_state()).IsEmpty();
+  if (views().toolbar && views().toolbar->background()) {
+    if (auto* const toolbar_background =
+            views().toolbar->background()->AsA<CustomCornersBackground>()) {
+      CustomCornersBackground::Corners corners;
+      if (card) {
+        corners[CornerOrientation::kTopLeading] = {
+            CustomCornersBackground::CornerType::kRoundedWithBackground,
+            uw::kPageCardRadius};
+        corners[CornerOrientation::kTopTrailing] = {
+            CustomCornersBackground::CornerType::kRoundedWithBackground,
+            uw::kPageCardRadius};
+      }
+      toolbar_background->SetCorners(corners);
+    }
+  }
+  views().multi_contents_view->SetBackgroundRadii(
+      card ? gfx::RoundedCornersF(0, 0, uw::kPageCardRadius,
+                                  uw::kPageCardRadius)
+           : gfx::RoundedCornersF());
+}
+
+bool BrowserViewPopupLayoutImpl::IsLittleWindow() const {
+  // The layout's host is always the BrowserView.
+  return views().browser_view &&
+         uw::IsLittleWindow(
+             static_cast<BrowserView*>(views().browser_view.get())->browser());
+}
