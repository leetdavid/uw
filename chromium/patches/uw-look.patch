+void PaintUwSymbol(gfx::Canvas* canvas,
+                   const gfx::Rect& contents,
+                   int button_type,
+                   SkColor color) {
+  const gfx::PointF center = gfx::RectF(contents).CenterPoint();
+  const auto at = [&](float x, float y) {
+    return gfx::PointF(center.x() + x - 8, center.y() + y - 8);
