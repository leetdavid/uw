+  // uses for incognito.
+  if (key.color_mode == ui::ColorProviderKey::ColorMode::kDark &&
+      !key.custom_theme && !UsingDeviceTheme() &&
+      !profile_->GetPrefs()->GetBoolean(uw::kThemeColorsInDarkModePref)) {
+    key.user_color_source = ui::ColorProviderKey::UserColorSource::kGrayscale;
+  }
+
   return key;
 }
 
