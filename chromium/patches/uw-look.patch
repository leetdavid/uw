+  flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+  switch (button_type) {
+    case VIEW_ID_MINIMIZE_BUTTON:
+      canvas->DrawLine(at(4, 8), at(12, 8), flags);
+      return;
+    case VIEW_ID_MAXIMIZE_BUTTON:
+      canvas->DrawRoundRect(gfx::RectF(at(4, 4), gfx::SizeF(8, 8)), 1.5f,
+                            flags);
+      return;
+    case VIEW_ID_RESTORE_BUTTON:
+      canvas->DrawRoundRect(gfx::RectF(at(4, 6), gfx::SizeF(6, 6)), 1.5f,
+                            flags);
+      canvas->DrawLine(at(6.5f, 4), at(12, 4), flags);
+      canvas->DrawLine(at(12, 4), at(12, 9.5f), flags);
+      return;
+    case VIEW_ID_CLOSE_BUTTON:
+      canvas->DrawLine(at(4.75f, 4.75f), at(11.25f, 11.25f), flags);
+      canvas->DrawLine(at(11.25f, 4.75f), at(4.75f, 11.25f), flags);
+      return;
+    default:
+      NOTREACHED();
+  }
+}
