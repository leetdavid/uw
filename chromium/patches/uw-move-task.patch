 void TabDragHandlerImpl::EndDrag(EndDragReason reason) {
+  // uw: a drop on a workspace's icon at the sidebar's foot puts the tabs back,
+  // as Escape does, and then moves them to that workspace.
+  if (reason == EndDragReason::kComplete && drag_controller_) {
+    if (base::OnceClosure move =
+            uw::TakeWorkspaceDrop(drag_controller_->GetSessionData())) {
+      drag_controller_->EndDrag(EndDragReason::kCancel);
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                               std::move(move));
+      return;
+    }
+  }
