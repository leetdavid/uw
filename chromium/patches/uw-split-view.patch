+
+void MultiContentsView::AddContentsContainerView() {
+  ContentsContainerView* view = AddChildViewAt(
+      std::make_unique<ContentsContainerView>(browser_view_),
+      GetIndexOf(contents_container_views_.back().get()).value() + 1);
+  view->SetVisible(false);
+  contents_container_views_.push_back(view);
+  ObserveContentsContainerView(view);
+
+  // The features that attach to every pane when the window opens attach to
+  // this one too.
+  BrowserWindowInterface* browser = browser_view_->browser();
+  if (auto* devtools = DevtoolsUIController::From(browser)) {
+    devtools->AddContentsContainerView(view);
+  }
+  BrowserWindowFeatures& features = browser->GetFeatures();
+  if (auto* footer = features.new_tab_footer_controller()) {
+    footer->AddContentsContainerView(view);
+  }
+  if (auto* border = features.contents_border_controller()) {
+    border->AddContentsContainerView(view, browser_view_);
+  }
+  if (auto* actor = ActorUiWindowController::From(browser);
+      actor && view->actor_overlay_web_view()) {
+    actor->AddContentsContainer(view->contents_view(),
+                                view->actor_overlay_web_view());
+  }
+  if (auto* data_protection =
+          enterprise_data_protection::DataProtectionUIController::From(
+              browser)) {
+    data_protection->AddContentsContainerView(view);
+  }
+}
+
+void MultiContentsView::UpdateResizeAreas() {
+  const size_t cuts = IsInSplitView() ? visual_data_.panes().cut_count() : 0;
+  while (resize_areas_.size() < cuts) {
+    resize_areas_.push_back(
+        AddChildViewAt(std::make_unique<MultiContentsResizeArea>(this),
+                       GetIndexOf(resize_areas_.back().get()).value() + 1));
+  }
+  for (size_t cut = 0; cut < resize_areas_.size(); ++cut) {
+    MultiContentsResizeArea* area = resize_areas_[cut];
+    area->set_cut(cut);
+    if (cut < cuts) {
+      area->SetLayout(visual_data_.panes().direction_of(cut) ==
+                              uw::SplitDirection::kStacked
+                          ? split_tabs::SplitTabLayout::kStacked
+                          : split_tabs::SplitTabLayout::kSideBySide);
+    }
+    area->SetVisible(cut < cuts);
+  }
+}
+
+void MultiContentsView::SwapContentsContainerViews(size_t a, size_t b) {
+  if (a == b) {
+    return;
+  }
+  // Reorder the child views so that focus order will be consistent with
+  // contents_container_views_.
+  ContentsContainerView* view_a = contents_container_views_[a];
+  ContentsContainerView* view_b = contents_container_views_[b];
+  const size_t child_a = GetIndexOf(view_a).value();
+  const size_t child_b = GetIndexOf(view_b).value();
+  ReorderChildView(view_a, child_b);
+  ReorderChildView(view_b, child_a);
+  std::swap(contents_container_views_[a], contents_container_views_[b]);
+  if (active_index_ == static_cast<int>(a)) {
+    active_index_ = b;
+  } else if (active_index_ == static_cast<int>(b)) {
+    active_index_ = a;
+  }
+}
+
+bool MultiContentsView::IsInactiveContentsView(
+    const content::WebContents* web_contents) const {
+  for (size_t i = 0; i < pane_count_; ++i) {
+    if (static_cast<int>(i) != active_index_ &&
+        contents_container_views_[i]->contents_view()->web_contents() ==
+            web_contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool MultiContentsView::InactiveContentsViewHasFocus() const {
+  for (size_t i = 0; i < pane_count_; ++i) {
+    if (static_cast<int>(i) != active_index_ &&
+        contents_container_views_[i]->contents_view()->HasFocus()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::vector<ContentsWebView*> MultiContentsView::GetVisibleContentsViews()
+    const {
+  std::vector<ContentsWebView*> views = {GetActiveContentsView()};
+  for (size_t i = 0; i < pane_count_; ++i) {
+    if (static_cast<int>(i) != active_index_) {
+      views.push_back(contents_container_views_[i]->contents_view());
+    }
+  }
+  return views;
+}
+
+void MultiContentsView::ClearInactiveContentsViews() {
+  for (size_t i = 0; i < contents_container_views_.size(); ++i) {
+    if (static_cast<int>(i) != active_index_) {
+      contents_container_views_[i]->contents_view()->SetWebContents(nullptr);
+    }
+  }
+}
+
+bool MultiContentsView::IsBelowAnotherPane(
+    const ContentsContainerView* container) const {
+  if (!IsInSplitView()) {
+    return false;
+  }
+  int top = container->y();
+  for (size_t i = 0; i < pane_count_; ++i) {
+    top = std::min(top, contents_container_views_[i]->y());
+  }
+  return container->y() > top;
+}
+
+gfx::Vector2dF MultiContentsView::GetActiveContentsShare() const {
+  if (!IsInSplitView() || split_area_.IsEmpty()) {
+    return gfx::Vector2dF(1, 1);
+  }
+  const gfx::Rect pane = GetActiveContentsContainerView()->bounds();
+  return gfx::Vector2dF(
+      std::clamp(static_cast<float>(pane.width()) / split_area_.width(), 0.05f,
+                 1.0f),
+      std::clamp(static_cast<float>(pane.height()) / split_area_.height(),
+                 0.05f, 1.0f));
+}
