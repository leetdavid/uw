+content::WebContents* MultiContentsView::GetMaximizedContents() const {
+  const tabs::TabInterface* tab =
+      maximized_ ? tabs::TabInterface::MaybeGetFromContents(maximized_.get())
+                 : nullptr;
+  return tab && tab->GetSplit() == maximized_split_ ? maximized_.get()
