+
+void MultiContentsView::SetMaximized(content::WebContents* contents) {
+  if (maximized_.get() == contents) {
+    return;
+  }
+  maximized_ = contents ? contents->GetWeakPtr() : nullptr;
+  maximized_split_ =
+      contents ? tabs::TabInterface::GetFromContents(contents)->GetSplit()
+               : std::nullopt;
+  // The layout hides the other panes and the dividers of a maximized pane, so
+  // they show again for the next layout to place.
+  for (size_t i = 0; i < pane_count_; ++i) {
+    contents_container_views_[i]->SetVisible(true);
+  }
+  UpdateResizeAreas();
+  UpdateContentsBorderAndOverlay();
+  InvalidateLayout();
+  maximized_changed_.Notify();
+}
+
+bool MultiContentsView::ShowsMaximized() const {
+  return IsInSplitView() && GetMaximizedContents() &&
+         GetActiveContentsView()->web_contents() == GetMaximizedContents();
+}
