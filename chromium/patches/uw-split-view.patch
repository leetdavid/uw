+void TabStripModel::SplitPane(int index,
+                              int new_index,
+                              split_tabs::SplitTabLayout direction) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  tabs::TabInterface* tab = GetTabAtIndex(index);
+  tabs::TabInterface* new_tab = GetTabAtIndex(new_index);
+  CHECK_NE(tab, new_tab);
+  CHECK(!new_tab->IsSplit());
+  const uw::SplitDirection way =
+      direction == split_tabs::SplitTabLayout::kStacked
+          ? uw::SplitDirection::kStacked
+          : uw::SplitDirection::kSideBySide;
+
+  if (!tab->IsSplit()) {
+    RemakeSplit(split_tabs::SplitTabId::GenerateNew(), {tab, new_tab},
+                split_tabs::SplitTabVisualData(uw::SplitLayout(way)),
+                SplitTabChange::SplitTabAddReason::kNewSplitTabAdded);
+    return;
+  }
+
+  const split_tabs::SplitTabId split_id = tab->GetSplit().value();
+  std::vector<tabs::TabInterface*> tabs = GetSplitData(split_id)->ListTabs();
+  split_tabs::SplitTabVisualData visual_data =
+      *GetSplitData(split_id)->visual_data();
+  const size_t pane = std::ranges::find(tabs, tab) - tabs.begin();
+  const size_t added = visual_data.panes().Split(pane, way);
+  tabs.insert(tabs.begin() + added, new_tab);
+  RemakeSplit(split_id, std::move(tabs), std::move(visual_data),
+              SplitTabChange::SplitTabAddReason::kSplitTabUpdated);
+}
