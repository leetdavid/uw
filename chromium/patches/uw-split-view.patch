+void TabStripModel::MoveTabOutOfSplit(int index) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  tabs::TabInterface* tab = GetTabAtIndex(index);
+  if (!tab->IsSplit()) {
+    return;
+  }
+  const split_tabs::SplitTabId split_id = tab->GetSplit().value();
+  std::vector<tabs::TabInterface*> split_tabs =
+      GetSplitData(split_id)->ListTabs();
+
+  if (std::optional<PendingSplit> rest = SplitWithout(split_id, {tab})) {
+    std::vector<tabs::TabInterface*> rest_tabs;
+    for (const tabs::TabHandle& handle : rest->tabs) {
+      rest_tabs.push_back(handle.Get());
+    }
+    RemakeSplit(split_id, rest_tabs, std::move(rest->visual_data),
+                SplitTabChange::SplitTabAddReason::kSplitTabUpdated);
+    split_tabs = std::move(rest_tabs);
+  } else {
+    RemoveSplitImpl(split_id,
+                    SplitTabChange::SplitTabRemoveReason::kSplitTabRemoved);
+    std::erase(split_tabs, tab);
+  }
+
+  // Just after the split, wherever the tab was in it.
+  int last = 0;
+  for (tabs::TabInterface* split_tab : split_tabs) {
+    last = std::max(last, GetIndexOfTab(split_tab));
+  }
+  const int from = GetIndexOfTab(tab);
+  if (from < last) {
+    MoveTabToIndexImpl(from, last, tab->GetGroup(), tab->IsPinned(),
+                       /*select_after_move=*/false);
+  }
+}
