+void DropPanes(std::vector<std::unique_ptr<tab_restore::Tab>>& tabs,
+               uw::SplitLayout& panes,
+               std::vector<bool> drop) {
+  for (size_t i = 0; i < tabs.size();) {
+    if (!drop[i]) {
+      ++i;
+      continue;
+    }
+    const uw::SplitLayout::Renumbering renumbering = panes.Remove(i);
+    std::vector<std::unique_ptr<tab_restore::Tab>> renumbered(tabs.size() - 1);
+    std::vector<bool> still_drop(tabs.size() - 1);
+    for (size_t j = 0; j < tabs.size(); ++j) {
+      if (renumbering.to[j]) {
+        renumbered[*renumbering.to[j]] = std::move(tabs[j]);
+        still_drop[*renumbering.to[j]] = drop[j];
+      }
+    }
+    tabs = std::move(renumbered);
+    drop = std::move(still_drop);
+    i = 0;
+  }
