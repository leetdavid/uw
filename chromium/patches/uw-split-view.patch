+std::optional<TabStripModel::PendingSplit> TabStripModel::SplitWithout(
+    split_tabs::SplitTabId split_id,
+    const std::vector<tabs::TabInterface*>& leaving) {
+  split_tabs::SplitTabData* split_data = GetSplitData(split_id);
+  std::vector<tabs::TabInterface*> tabs = split_data->ListTabs();
+  PendingSplit pending(split_id, *split_data->visual_data());
+  uw::SplitLayout& panes = pending.visual_data.panes();
+  if (panes.pane_count() != tabs.size()) {
+    return std::nullopt;
+  }
+  for (tabs::TabInterface* tab : leaving) {
+    auto it = std::ranges::find(tabs, tab);
+    if (it == tabs.end()) {
+      continue;
+    }
+    if (tabs.size() <= 2) {
+      return std::nullopt;
+    }
+    const uw::SplitLayout::Renumbering renumbering =
+        panes.Remove(it - tabs.begin());
+    std::vector<tabs::TabInterface*> renumbered(tabs.size() - 1);
+    for (size_t i = 0; i < tabs.size(); ++i) {
+      if (renumbering.to[i]) {
+        renumbered[*renumbering.to[i]] = tabs[i];
+      }
+    }
+    tabs = std::move(renumbered);
+  }
+  for (tabs::TabInterface* tab : tabs) {
+    pending.tabs.push_back(tab->GetHandle());
+  }
+  return pending;
+}
+
+void TabStripModel::RemakeSplit(split_tabs::SplitTabId split_id,
+                                std::vector<tabs::TabInterface*> tabs,
+                                split_tabs::SplitTabVisualData visual_data,
+                                SplitTabChange::SplitTabAddReason reason) {
+  CHECK_GE(tabs.size(), 2u);
+  CHECK_EQ(visual_data.panes().pane_count(), tabs.size());
+  if (contents_data_->GetSplitTabCollection(split_id)) {
+    RemoveSplitImpl(split_id,
+                    SplitTabChange::SplitTabRemoveReason::kSplitTabUpdated);
+  }
+
+  // Line the tabs up in pane order from where the first of them is.
+  const std::optional<tab_groups::TabGroupId> group = tabs[0]->GetGroup();
+  const bool pinned = tabs[0]->IsPinned();
+  int start = GetIndexOfTab(tabs[0]);
+  for (tabs::TabInterface* tab : tabs) {
+    start = std::min(start, GetIndexOfTab(tab));
+  }
+  std::vector<int> indices;
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    const int to = start + static_cast<int>(i);
+    const int from = GetIndexOfTab(tabs[i]);
+    if (from != to || tabs[i]->GetGroup() != group ||
+        tabs[i]->IsPinned() != pinned) {
+      MoveTabToIndexImpl(from, to, group, pinned, /*select_after_move=*/false);
+    }
+    indices.push_back(to);
+  }
+
+  const int pivot =
+      std::ranges::contains(indices, active_index()) ? active_index() : start;
+  AddToSplitImpl(split_id, indices, pivot, std::move(visual_data), reason);
+}
+
+void TabStripModel::RemakePendingSplits() {
+  if (remaking_splits_ || pending_splits_.empty()) {
+    return;
+  }
+  if (closing_all_) {
+    pending_splits_.clear();
+    return;
+  }
