+TabStripModel::PendingSplit::PendingSplit(
+    split_tabs::SplitTabId id,
+    split_tabs::SplitTabVisualData visual_data)
+    : id(id), visual_data(std::move(visual_data)) {}
+TabStripModel::PendingSplit::PendingSplit(const PendingSplit&) = default;
+TabStripModel::PendingSplit& TabStripModel::PendingSplit::operator=(
+    const PendingSplit&) = default;
+TabStripModel::PendingSplit::~PendingSplit() = default;
