diff --git a/chrome/browser/ui/browser_live_tab_context.cc b/chrome/browser/ui/browser_live_tab_context.cc
index 29db497993227311233af1caa1e346cb49e1c0c8..fcb43cae0d9c521bafd8e1b2668433f5bd25ee58 100644
--- a/chrome/browser/ui/browser_live_tab_context.cc
+++ b/chrome/browser/ui/browser_live_tab_context.cc
@@ -465,6 +465,40 @@ void BrowserLiveTabContext::ReconstructSplit(
   }
 }
 
+void BrowserLiveTabContext::ReconstructSplitOfTabs(
+    const std::vector<sessions::LiveTab*>& tabs,
+    split_tabs::SplitTabId split_id,
+    const split_tabs::SplitTabVisualData& visual_data,
+    size_t focused_pane) {
+  std::vector<int> indices;
+  for (sessions::LiveTab* tab : tabs) {
+    const int index = tab_strip_model_->GetIndexOfWebContents(
+        &static_cast<sessions::ContentLiveTab*>(tab)->GetWebContents());
+    if (index == TabStripModel::kNoTab) {
+      return;
+    }
+    indices.push_back(index);
+  }
+  // The tabs were restored next to each other in pane order.
+  if (!std::ranges::is_sorted(indices) ||
+      visual_data.panes().pane_count() != indices.size()) {
+    return;
+  }
+  // The split brings its tabs together, so the pane to focus is found by its
+  // page afterwards.
+  const bool selected = tab_strip_model_->active_index() == indices[0];
+  content::WebContents* focused =
+      focused_pane < tabs.size()
+          ? &static_cast<sessions::ContentLiveTab*>(tabs[focused_pane])
+                 ->GetWebContents()
+          : nullptr;
+  tab_strip_model_->RestoreSplit(split_id, indices, visual_data);
+  if (selected && focused) {
+    tab_strip_model_->ActivateTabAt(
+        tab_strip_model_->GetIndexOfWebContents(focused));
+  }
+}
+
 void BrowserLiveTabContext::CloseTab() {
   chrome::CloseTab(&*browser_);
 }
