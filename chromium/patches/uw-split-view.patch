-    : split_layout_(split_layout) {}
+    : panes_(DirectionOf(split_layout)) {}
 
 SplitTabVisualData::SplitTabVisualData(SplitTabLayout split_layout,
                                        double split_ratio)
-    : split_layout_(split_layout), split_ratio_(split_ratio) {}
+    : panes_(DirectionOf(split_layout), UsableRatio(split_ratio)) {}
+
+SplitTabVisualData::SplitTabVisualData(uw::SplitLayout panes)
+    : panes_(std::move(panes)) {}
 
 SplitTabVisualData::~SplitTabVisualData() = default;
 
+void SplitTabVisualData::set_split_layout(SplitTabLayout split_layout) {
+  panes_.SetDirection(0, DirectionOf(split_layout));
+  panes_.Renumber();
+}
+
+void SplitTabVisualData::set_split_ratio(double split_ratio) {
+  panes_.SetRatio(0, UsableRatio(split_ratio));
+}
+
+SplitTabLayout SplitTabVisualData::split_layout() const {
+  return panes_.direction() == uw::SplitDirection::kStacked
+             ? SplitTabLayout::kStacked
+             : SplitTabLayout::kSideBySide;
+}
+
+double SplitTabVisualData::split_ratio() const {
+  return panes_.ratio();
+}
+
 }  // namespace split_tabs
