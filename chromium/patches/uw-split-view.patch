 #include "components/split_tabs/split_tab_visual_data.h"
 
+#include <algorithm>
+
 namespace split_tabs {
 
+namespace {
+
+uw::SplitDirection DirectionOf(SplitTabLayout layout) {
+  return layout == SplitTabLayout::kStacked ? uw::SplitDirection::kStacked
+                                            : uw::SplitDirection::kSideBySide;
+}
+
+// A ratio read from an old or broken session file can be 0 or 1, which would
+// hide a pane.
+double UsableRatio(double ratio) {
+  return std::clamp(ratio, 0.05, 0.95);
+}
+
+}  // namespace
+
 SplitTabVisualData::SplitTabVisualData()
-    : split_layout_(SplitTabLayout::kSideBySide) {}
+    : panes_(uw::SplitDirection::kSideBySide) {}
 
