+NSMenuItem* BuildTasksMenu(NSApplication* nsapp,
+                           id app_delegate,
+                           const std::u16string& product_name,
+                           bool is_pwa,
+                           bool is_rtl) {
+  if (is_pwa) {
+    return nil;
+  }
+
+  std::vector<Item> go_to_task;
+  for (int task = 0; task < 9; ++task) {
+    go_to_task.push_back(
+        Item(IDS_UW_TASK_NUMBER_MAC)
+            .command_id(uw::kGoToTask1 + task)
+            .string_format_1(base::NumberToString16(task + 1)));
+  }
+  go_to_task.push_back(
+      Item(IDS_UW_SCRATCHPAD).command_id(uw::kGoToScratchpad));
+
+  // clang-format off
+  return Item(IDS_UW_TASKS_MENU_MAC)
+      .submenu({
+          Item(IDS_UW_NEW_TASK_MAC)
+              .command_id(IDC_CREATE_NEW_TAB_GROUP)
+              .key_equivalent(@"n", NSEventModifierFlagCommand |
+                                        NSEventModifierFlagControl),
+          Item(IDS_UW_MOVE_TO_NEW_TASK_MAC)
+              .command_id(uw::TabOrganizationController::kNewTask),
+          Item(IDS_UW_MOVE_TO_SCRATCHPAD_MAC)
+              .command_id(uw::TabOrganizationController::kScratchpad),
+          Item(IDS_UW_KEEP_HERE_MAC)
+              .command_id(uw::TabOrganizationController::kKeepHere),
+          Item().is_separator(),
+          Item(IDS_UW_GO_TO_TASK_MAC).submenu(std::move(go_to_task)),
+          Item(IDS_UW_RENAME_TASK_MAC).command_id(uw::kRenameTask),
+          Item(IDS_UW_NAME_TASK_MAC).command_id(uw::kNameTask),
+          Item(IDS_UW_CLOSE_TASK_MAC)
+              .command_id(IDC_CLOSE_TAB_GROUP)
+              .key_equivalent(@"w", NSEventModifierFlagCommand |
+                                        NSEventModifierFlagControl),
+          Item().is_separator(),
+          Item(IDS_UW_CONFIRM_SUGGESTION_MAC)
+              .command_id(uw::kConfirmSuggestion),
+          Item(IDS_UW_UNDO_ORGANIZATION_MAC)
+              .command_id(uw::TabOrganizationController::kUndo),
+          Item(IDS_UW_SHOW_ACTIVITY_MAC)
+              .command_id(uw::kShowOrganizerActivity),
+          Item().is_separator(),
+          Item(IDS_UW_PAUSE_1HOUR_MAC)
+              .command_id(uw::kPauseOrganizationForAnHour),
+          Item(IDS_UW_PAUSE_UNTIL_LAUNCH_MAC)
+              .command_id(uw::kPauseOrganizationUntilLaunch),
+          Item(IDS_UW_PAUSE_INDEFINITE_MAC)
+              .command_id(uw::kPauseOrganizationIndefinitely),
+          Item(IDS_UW_PAUSE_RESUME_MAC)
+              .command_id(uw::kResumeOrganization),
+          Item().is_separator(),
+          Item(IDS_UW_ORGANIZATION_SETTINGS_MAC)
+              .command_id(uw::kShowOrganizationSettings),
+      })
+      .Build();
+  // clang-format on
+}
