+void TranslateAgent::RequestNextSegments() {
+  WebLocalFrame* main_frame = render_frame()->GetWebFrame();
+  if (!main_frame) {
+    return;
+  }
+  WebScriptSource source(WebString::FromAscii("uwTranslate.next()"));
+  main_frame->RequestExecuteScript(
+      world_id_, base::span_from_ref(source),
+      blink::mojom::UserActivationOption::kDoNotActivate,
+      blink::mojom::EvaluationTiming::kAsynchronous,
+      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
+      base::BindOnce(&TranslateAgent::OnSegments,
+                     weak_method_factory_.GetWeakPtr()),
+      blink::BackForwardCacheAware::kAllow,
+      blink::mojom::WantResultOption::kWantResult,
+      blink::mojom::PromiseResultOption::kAwait,
+      /*is_injected_extension_script=*/false);
+}
+
+void TranslateAgent::OnSegments(std::optional<base::Value> batch,
+                                base::TimeTicks start_time) {
+  if (!batch || !batch->is_dict()) {
+    return;
+  }
+  const base::DictValue& dict = batch->GetDict();
+  std::optional<int> id = dict.FindInt("id");
+  const base::ListValue* texts = dict.FindList("texts");
+  const std::string* source = dict.FindString("source");
+  const std::string* target = dict.FindString("target");
+  if (!id || !texts || !source || !target) {
+    return;
+  }
+  std::vector<std::string> segments;
+  for (const base::Value& text : *texts) {
+    segments.push_back(text.is_string() ? text.GetString() : std::string());
+  }
+  GetTranslateHandler()->TranslateSegments(
+      std::move(segments), *source, *target,
+      base::BindOnce(&TranslateAgent::OnSegmentsTranslated,
+                     weak_method_factory_.GetWeakPtr(), *id));
+  RequestNextSegments();
+}
+
+void TranslateAgent::OnSegmentsTranslated(
+    int batch_id,
+    const std::optional<std::vector<std::string>>& translations,
+    int32_t error) {
+  WebLocalFrame* main_frame = render_frame()->GetWebFrame();
+  if (!main_frame) {
+    return;
+  }
+  std::string json = "null";
+  if (translations) {
+    base::ListValue list;
+    for (const std::string& translation : *translations) {
+      list.Append(translation);
+    }
+    base::JSONWriter::Write(list, &json);
+  }
+  std::string script = "uwTranslate.deliver(" + base::NumberToString(batch_id) +
+                       "," + json + "," + base::NumberToString(error) + ")";
+  main_frame->ExecuteScriptInIsolatedWorld(
+      world_id_, WebScriptSource(WebString::FromUtf8(script)),
+      blink::BackForwardCacheAware::kAllow);
+}
