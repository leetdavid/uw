diff --git a/chrome/browser/updater/updater_no_updater.cc b/chrome/browser/updater/updater_no_updater.cc
index d449bc0..a9c3ed6 100644
--- a/chrome/browser/updater/updater_no_updater.cc
+++ b/chrome/browser/updater/updater_no_updater.cc
@@ -13,11 +13,23 @@
 #include "base/task/task_traits.h"
 #include "base/version.h"
 #include "base/version_info/version_info.h"
+#include "build/build_config.h"
 #include "chrome/updater/mojom/updater_service.mojom.h"
 
+#if BUILDFLAG(IS_MAC)
+#include "uw/browser/update/pending_update.h"
+#endif
+
 namespace updater {
 
 base::Version CurrentlyInstalledVersion() {
+#if BUILDFLAG(IS_MAC)
+  // uw: an update Sparkle has downloaded reads as an unknown installed
+  // version, which Chromium treats as an update waiting for a relaunch.
+  if (uw::HasPendingUpdate()) {
+    return base::Version();
+  }
+#endif
   return version_info::GetVersion();
 }
 
