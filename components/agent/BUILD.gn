# How uw's agent reads a page and talks to its model. See
# docs/plans/agent-chats.md.
source_set("agent") {
  sources = [
    "agent_context.cc",
    "agent_context.h",
    "agent_protocol.cc",
    "agent_protocol.h",
    "chat_scheduler.cc",
    "chat_scheduler.h",
    "command_check.cc",
    "command_check.h",
    "page_text.cc",
    "page_text.h",
    "run_report.cc",
    "run_report.h",
    "schedule.cc",
    "schedule.h",
    "scheduled_chat.cc",
    "scheduled_chat.h",
    "skills.cc",
    "skills.h",
    "suggestions.cc",
    "suggestions.h",
  ]
  public_deps = [
    "//base",
    "//uw/components/tab_organization",
    "//url",
  ]
  deps = [
    "//base:i18n",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//third_party/icu",
    "//uw/components/ai_providers",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "agent_context_unittest.cc",
    "agent_protocol_unittest.cc",
    "chat_scheduler_unittest.cc",
    "command_check_unittest.cc",
    "page_text_unittest.cc",
    "run_report_unittest.cc",
    "schedule_unittest.cc",
    "scheduled_chat_unittest.cc",
    "skills_unittest.cc",
    "suggestions_unittest.cc",
  ]
  deps = [
    ":agent",
    "//base",
    "//base/test:test_support",
    "//components/optimization_guide/proto:optimization_guide_proto",
    "//testing/gmock",
    "//testing/gtest",
    "//url",
  ]
}
