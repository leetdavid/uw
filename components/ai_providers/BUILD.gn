# The AI providers the user saves once, the model choices that pick from
# them, and the formats uw speaks to them. See docs/plans/ai-providers.md.
source_set("ai_providers") {
  sources = [
    "formats.cc",
    "formats.h",
    "providers.cc",
    "providers.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//components/prefs" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "formats_unittest.cc",
    "providers_unittest.cc",
  ]
  deps = [
    ":ai_providers",
    "//base",
    "//base/test:test_support",
    "//components/prefs:test_support",
    "//testing/gtest",
  ]
}
